---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2' | 'h3';
}

const { eyebrow, title, description, align = 'start', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['section-title', `section-title--${align}`]} data-reveal={Tag === 'h1' ? undefined : true}>
  {eyebrow && <span class="section-title__eyebrow">{eyebrow}</span>}
  <Tag class="section-title__title text-balance">{title}</Tag>
  {description && <p class="section-title__description text-balance">{description}</p>}
</div>

<style>
  .section-title {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    max-width: 640px;
  }

  .section-title--center {
    margin-inline: auto;
    text-align: center;
    align-items: center;
  }

  .section-title__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.02em;
    color: var(--color-primary-hover);
    background: var(--color-primary-soft);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .section-title__description {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
  }
</style>
