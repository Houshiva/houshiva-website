---
import { site } from '../../data/site';

export interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<ul class:list={['social-links', className]}>
  {
    site.social.map((item) => (
      <li>
        <a href={item.url} target="_blank" rel="noopener noreferrer" aria-label={item.name}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {item.platform === 'instagram' && (
              <g fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                <circle cx="12" cy="12" r="4.2" />
                <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
              </g>
            )}

            {item.platform === 'youtube' && (
              <g fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
                <path d="M10.3 9.3v5.4l4.7-2.7-4.7-2.7Z" fill="currentColor" stroke="none" />
              </g>
            )}

            {item.platform === 'aparat' && (
              <g fill="none" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9" />
                <path d="M10 8.7v6.6l5.7-3.3L10 8.7Z" fill="currentColor" stroke="none" />
              </g>
            )}

            {item.platform === 'github' && (
              <path
                fill="currentColor"
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.14c-3.2.7-3.87-1.36-3.87-1.36-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.69 1.25 3.34.95.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.19-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.83 1.18 3.09 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.13v3.15c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              />
            )}
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .social-links a:hover {
    color: var(--tone-accent-hover);
    border-color: var(--tone-accent);
    background: var(--tone-accent-soft);
  }
</style>
