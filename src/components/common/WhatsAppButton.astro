---
const phone = '989355958047';
const message = 'سلام، وقت بخیر. می‌خواستم درباره یک پروژه با تیم هوشیوا مشورت بگیرم.';
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a href={href} class="whatsapp-fab" target="_blank" rel="noopener noreferrer" aria-label="گفتگو در واتساپ با هوشیوا">
  <span class="whatsapp-fab__ring" aria-hidden="true"></span>
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true" focusable="false">
    <path
      d="M16.02 3C9.4 3 4 8.37 4 15c0 2.2.6 4.27 1.63 6.06L3 29l8.16-2.55A12.9 12.9 0 0 0 16.02 27C22.63 27 28 21.63 28 15S22.63 3 16.02 3Zm0 23.4a11.3 11.3 0 0 1-5.77-1.58l-.41-.24-4.85 1.52 1.55-4.72-.27-.44A11.3 11.3 0 1 1 16.02 26.4Z"
    />
    <path
      d="M21.9 18.02c-.32-.16-1.9-.94-2.2-1.04-.3-.11-.51-.16-.73.16-.22.32-.83 1.04-1.02 1.25-.19.22-.38.24-.7.08-.32-.16-1.34-.5-2.55-1.6-.94-.84-1.58-1.88-1.76-2.2-.19-.32-.02-.49.14-.65.14-.14.32-.38.48-.57.16-.19.21-.32.32-.54.11-.22.05-.4-.03-.57-.08-.16-.73-1.78-1-2.43-.26-.63-.53-.55-.73-.56-.19-.01-.4-.01-.62-.01-.22 0-.57.08-.87.4-.3.32-1.14 1.12-1.14 2.73 0 1.6 1.17 3.16 1.33 3.38.16.22 2.3 3.55 5.58 4.98.78.34 1.39.54 1.87.69.78.25 1.5.21 2.06.13.63-.09 1.9-.78 2.17-1.53.27-.75.27-1.4.19-1.53-.08-.13-.29-.21-.61-.37Z"
    />
  </svg>
</a>

<style>
  .whatsapp-fab {
    position: fixed;
    z-index: var(--z-header);
    bottom: var(--space-6);
    right: var(--space-6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: #25d366;
    color: #ffffff;
    box-shadow: var(--shadow-lg);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .whatsapp-fab:hover {
    transform: scale(1.06);
    box-shadow: 0 0 0 1px rgba(37, 211, 102, 0.3), var(--shadow-lg);
  }

  .whatsapp-fab__ring {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    background: #25d366;
    opacity: 0.55;
    animation: whatsapp-pulse 2.4s ease-out infinite;
  }

  @keyframes whatsapp-pulse {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-fab__ring {
      animation: none;
      display: none;
    }
  }

  @media (max-width: 640px) {
    .whatsapp-fab {
      width: 52px;
      height: 52px;
      bottom: var(--space-4);
      right: var(--space-4);
    }
  }
</style>
