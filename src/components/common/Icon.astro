---
/**
 * Hand-built monoline icon set (24x24, stroke-based) — no icon library dependency.
 * Keeps every icon used across the site in one place for visual consistency.
 */
export type IconName =
  | 'globe'
  | 'cart'
  | 'code'
  | 'calculator'
  | 'pos'
  | 'users'
  | 'warehouse'
  | 'workflow'
  | 'dashboard'
  | 'api'
  | 'menu'
  | 'close'
  | 'arrow-start'
  | 'check'
  | 'phone'
  | 'mail'
  | 'chevron-start'
  | 'spark'
  | 'target'
  | 'layers'
  | 'refresh'
  | 'compass'
  | 'play'
  | 'book'
  | 'video'
  | 'clock'
  | 'calendar'
  | 'cash'
  | 'hash'
  | 'trending-up'
  | 'copy';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'globe' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <ellipse cx="12" cy="12" rx="4" ry="9" />
      <path d="M3 12h18" />
    </>
  )}

  {name === 'cart' && (
    <>
      <path d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h7.1a2 2 0 0 0 2-1.6L20 8H6" />
      <circle cx="9.5" cy="20" r="1.4" />
      <circle cx="17" cy="20" r="1.4" />
    </>
  )}

  {name === 'code' && (
    <>
      <path d="M9 8 4.5 12 9 16" />
      <path d="M15 8l4.5 4-4.5 4" />
    </>
  )}

  {name === 'calculator' && (
    <>
      <rect x="5" y="3" width="14" height="18" rx="2.5" />
      <path d="M8 7.5h8" />
      <path d="M8 12h.01M12 12h.01M16 12h.01M8 16h.01M12 16h.01M16 16h.01" stroke-width="2.2" />
    </>
  )}

  {name === 'pos' && (
    <>
      <rect x="4" y="5" width="16" height="12" rx="2" />
      <path d="M8 17v2.2M16 17v2.2M7 21h10" />
      <path d="M7.5 9h9" />
    </>
  )}

  {name === 'users' && (
    <>
      <circle cx="9" cy="8.5" r="3" />
      <path d="M3.5 19c.7-3.2 3-5 5.5-5s4.8 1.8 5.5 5" />
      <circle cx="17" cy="8" r="2.3" />
      <path d="M15.8 11.3c2 .2 3.6 1.9 4.2 4.4" />
    </>
  )}

  {name === 'warehouse' && (
    <>
      <path d="M4 10.5 12 4l8 6.5" />
      <path d="M5.5 9.5V20h13V9.5" />
      <path d="M10 20v-5.5h4V20" />
    </>
  )}

  {name === 'workflow' && (
    <>
      <circle cx="5.5" cy="6" r="2.2" />
      <circle cx="5.5" cy="18" r="2.2" />
      <circle cx="18.5" cy="12" r="2.2" />
      <path d="M7.6 6.8 16.6 11M7.6 17.2 16.6 13" />
    </>
  )}

  {name === 'dashboard' && (
    <>
      <rect x="3.5" y="3.5" width="7.5" height="9" rx="1.8" />
      <rect x="13" y="3.5" width="7.5" height="5.5" rx="1.8" />
      <rect x="13" y="11" width="7.5" height="9.5" rx="1.8" />
      <rect x="3.5" y="14.5" width="7.5" height="6" rx="1.8" />
    </>
  )}

  {name === 'api' && (
    <>
      <path d="M9 3v4M15 3v4" />
      <rect x="6" y="7" width="12" height="7" rx="2" />
      <path d="M9 21v-4M15 21v-4" />
    </>
  )}

  {name === 'menu' && (
    <>
      <path d="M4 7h16M4 12h16M4 17h16" />
    </>
  )}

  {name === 'close' && (
    <>
      <path d="M6 6l12 12M18 6 6 18" />
    </>
  )}

  {name === 'arrow-start' && <path d="M20 12H4M10 6l-6 6 6 6" />}

  {name === 'check' && <path d="M5 12.5 10 17l9-10" />}

  {name === 'phone' && (
    <path d="M6.5 4h2.3l1.4 4.2-2 1.6a12.5 12.5 0 0 0 6 6l1.6-2 4.2 1.4V17.7a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.5 6.2 2 2 0 0 1 6.5 4Z" />
  )}

  {name === 'mail' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="2.2" />
      <path d="M4.5 7 12 12.5 19.5 7" />
    </>
  )}

  {name === 'chevron-start' && <path d="M14.5 6 8.5 12l6 6" />}

  {name === 'spark' && (
    <path d="M12 3.5c.6 3.4 2.4 5.2 5.8 5.8-3.4.6-5.2 2.4-5.8 5.8-.6-3.4-2.4-5.2-5.8-5.8 3.4-.6 5.2-2.4 5.8-5.8Z" />
  )}

  {name === 'target' && (
    <>
      <circle cx="12" cy="12" r="8" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="12" cy="12" r="0.6" fill="currentColor" />
    </>
  )}

  {name === 'layers' && (
    <>
      <path d="m12 3 8 4.5-8 4.5-8-4.5Z" />
      <path d="m4 12 8 4.5 8-4.5" />
      <path d="m4 16.5 8 4.5 8-4.5" />
    </>
  )}

  {name === 'refresh' && (
    <>
      <path d="M4.5 12a7.5 7.5 0 0 1 12.6-5.5L19.5 8" />
      <path d="M19.5 12a7.5 7.5 0 0 1-12.6 5.5L4.5 16" />
      <path d="M19.5 4.5V8h-3.5M4.5 19.5V16H8" />
    </>
  )}

  {name === 'compass' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="m14.5 9.5-1.7 5.2-5.2 1.7 1.7-5.2 5.2-1.7Z" />
    </>
  )}

  {name === 'play' && <path d="M8 6.3v11.4a.9.9 0 0 0 1.37.76l9.1-5.7a.9.9 0 0 0 0-1.52l-9.1-5.7A.9.9 0 0 0 8 6.3Z" fill="currentColor" stroke="none" />}

  {name === 'book' && (
    <>
      <path d="M4 5.5a2 2 0 0 1 2-2h5.5v17H6a2 2 0 0 0-2 2Z" />
      <path d="M20 5.5a2 2 0 0 0-2-2h-5.5v17H18a2 2 0 0 1 2 2Z" />
    </>
  )}

  {name === 'video' && (
    <>
      <rect x="3" y="6" width="13" height="12" rx="2.2" />
      <path d="m21 8.5-5 3 5 3Z" stroke-linejoin="round" />
    </>
  )}

  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3.2 2" />
    </>
  )}

  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.2" />
      <path d="M3.5 9.5h17M8 3v4M16 3v4" />
      <path d="M7.5 13.5h2M11 13.5h2M14.5 13.5h2M7.5 17h2M11 17h2" />
    </>
  )}

  {name === 'cash' && (
    <>
      <rect x="2.5" y="6" width="19" height="12" rx="2.2" />
      <circle cx="12" cy="12" r="2.8" />
      <path d="M5.5 8v0M18.5 16v0" stroke-width="2.4" />
    </>
  )}

  {name === 'hash' && (
    <path d="M9.5 3.5 7 20.5M17 3.5l-2.5 17M4 8.5h16M3.3 15.5h16" />
  )}

  {name === 'trending-up' && (
    <>
      <path d="m3.5 16 6-6.2 4 4L20.5 6" />
      <path d="M15 6h5.5v5.5" />
    </>
  )}

  {name === 'copy' && (
    <>
      <rect x="8.5" y="8.5" width="12" height="12" rx="2.2" />
      <path d="M15.5 8.5V6a2 2 0 0 0-2-2H5.5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2.5" />
    </>
  )}
</svg>
