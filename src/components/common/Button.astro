---
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className } = Astro.props;
const Tag = href ? 'a' : 'button';
const isExternal = href?.startsWith('http');
---

<Tag
  href={href}
  type={!href ? type : undefined}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn--md {
    padding: var(--space-3) var(--space-6);
    font-size: var(--font-size-sm);
  }

  .btn--lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--font-size-base);
  }

  .btn--primary {
    background: var(--tone-accent);
    color: var(--color-text-on-primary);
  }

  .btn--primary:hover {
    background: var(--tone-accent-hover);
    box-shadow: var(--tone-glow);
  }

  .btn--secondary {
    background: var(--color-surface-elevated);
    color: var(--color-text);
    border-color: var(--color-border-strong);
  }

  .btn--secondary:hover {
    background: var(--color-surface-hover);
    border-color: var(--tone-accent);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text);
    border-color: var(--color-border);
  }

  .btn--ghost:hover {
    border-color: var(--tone-accent);
    color: var(--tone-accent-hover);
  }
</style>
