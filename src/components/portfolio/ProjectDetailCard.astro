---
import ProjectCover from '../illustrations/ProjectCover.astro';
import Icon from '../common/Icon.astro';
import { projectCategories, type Project } from '../../data/projects';

export interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="project-detail" data-reveal>
  <div class="project-detail__cover">
    <ProjectCover variant={project.cover as any} />
  </div>

  <div class="project-detail__body">
    <span class="project-detail__category">{projectCategories[project.category]}</span>
    <h2>{project.title}</h2>
    <p class="project-detail__lead">{project.shortDescription}</p>

    <div class="project-detail__grid">
      <div>
        <h3>نیاز و مسئله</h3>
        <p>{project.problem}</p>
      </div>
      <div>
        <h3>راهکار</h3>
        <p>{project.solution}</p>
      </div>
    </div>

    <div class="project-detail__footer">
      <ul class="project-detail__tech">
        {project.technologies.map((tech) => <li>{tech}</li>)}
      </ul>

      {
        project.link && (
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="project-detail__link">
            مشاهده پروژه
            <Icon name="chevron-start" size={16} />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-detail {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-8);
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .project-detail__cover {
    border-radius: var(--radius-md);
    overflow: hidden;
    align-self: start;
  }

  .project-detail__cover :global(svg) {
    width: 100%;
    height: auto;
  }

  .project-detail__category {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-hover);
  }

  .project-detail__body h2 {
    font-size: var(--font-size-2xl);
    margin-block: var(--space-2) var(--space-3);
  }

  .project-detail__lead {
    font-size: var(--font-size-base);
    margin-bottom: var(--space-6);
  }

  .project-detail__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .project-detail__grid h3 {
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-2);
  }

  .project-detail__grid p {
    font-size: var(--font-size-sm);
  }

  .project-detail__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-hairline);
  }

  .project-detail__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .project-detail__tech li {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    background: var(--color-background-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
  }

  .project-detail__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-hover);
    flex-shrink: 0;
  }

  @media (max-width: 720px) {
    .project-detail {
      grid-template-columns: 1fr;
    }

    .project-detail__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
