---
/**
 * Houshiva mark: official brand logo (H + S monogram in a hexagon).
 */
export interface Props {
  size?: number;
  withWordmark?: boolean;
  class?: string;
}

const { size = 32, withWordmark = true, class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <img
    src="/brand/houshiva-logo.png"
    width={size}
    height={Math.round(size * 1.134)}
    alt="هوشیوا"
    class="logo__mark"
  />
  {withWordmark && <span class="logo__wordmark">هوشیوا</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .logo__mark {
    flex-shrink: 0;
    display: block;
  }

  .logo__wordmark {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
</style>
