  @media (prefers-reduced-motion: reduce) {
    .svis :global(*) {
      animation: none !important;
    }
  }
</style>

<script>
  // Run each scene's animation only while it is on screen.
  function initServiceVisuals() {
    const scenes = document.querySelectorAll<SVGElement>('.svis:not([data-sv-bound])');
    if (!scenes.length) return;
    const observer = new IntersectionObserver(
      (entries) => entries.forEach((entry) => entry.target.classList.toggle('is-active', entry.isIntersecting)),
      { threshold: 0.15 },
    );
    scenes.forEach((scene) => {
      scene.setAttribute('data-sv-bound', '');
      observer.observe(scene);
    });
  }

  document.addEventListener('astro:page-load', initServiceVisuals);
</script>
