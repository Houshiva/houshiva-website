---
/**
 * Custom hero visual: a central dashboard card connected to satellite
 * business-system nodes — visualizes what Houshiva actually does
 * (unifying a company's software systems), instead of a generic laptop/code stock image.
 */
import Icon from '../common/Icon.astro';

const satellites = [
  { icon: 'cart' as const, x: 78, y: 108 },
  { icon: 'users' as const, x: 522, y: 96 },
  { icon: 'warehouse' as const, x: 66, y: 418 },
  { icon: 'calculator' as const, x: 534, y: 404 },
];

const cardCenter = { x: 300, y: 262 };
---

<svg
  class="hero-illustration"
  viewBox="0 0 600 520"
  fill="none"
  role="img"
  aria-label="نمایی انتزاعی از داشبورد مدیریتی هوشیوا و اتصال آن به سامانه‌های کسب‌وکار"
>
  <defs>
    <radialGradient id="hero-glow" cx="50%" cy="46%" r="55%">
      <stop offset="0%" stop-color="var(--color-primary)" stop-opacity="0.28" />
      <stop offset="100%" stop-color="var(--color-primary)" stop-opacity="0" />
    </radialGradient>
  </defs>

  <circle cx={cardCenter.x} cy={cardCenter.y} r="230" fill="url(#hero-glow)" />

  {
    satellites.map((node) => (
      <line
        x1={cardCenter.x}
        y1={cardCenter.y}
        x2={node.x}
        y2={node.y}
        stroke="var(--color-border-strong)"
        stroke-width="1.5"
        stroke-dasharray="3 7"
        stroke-linecap="round"
      />
    ))
  }

  <!-- central dashboard card -->
  <g>
    <rect
      x="180"
      y="142"
      width="240"
      height="240"
      rx="24"
      fill="var(--color-surface)"
      stroke="var(--color-border)"
    />
    <rect x="204" y="172" width="72" height="10" rx="5" fill="var(--color-text-subtle)" opacity="0.6" />
    <circle cx="392" cy="177" r="7" fill="var(--color-primary)" />

    <rect x="204" y="200" width="112" height="30" rx="15" fill="var(--color-primary-soft)" />
    <rect x="218" y="211" width="52" height="8" rx="4" fill="var(--color-primary)" opacity="0.7" />

    <rect x="204" y="304" width="16" height="58" rx="4" fill="var(--color-primary-soft)" />
    <rect x="230" y="284" width="16" height="78" rx="4" fill="var(--color-primary)" />
    <rect x="256" y="296" width="16" height="66" rx="4" fill="var(--color-primary-soft)" />
    <rect x="282" y="266" width="16" height="96" rx="4" fill="var(--color-primary)" />
    <rect x="308" y="290" width="16" height="72" rx="4" fill="var(--color-primary-soft)" />
    <rect x="334" y="276" width="16" height="86" rx="4" fill="var(--color-primary)" />
  </g>

  {
    satellites.map((node, i) => (
      <g transform={`translate(${node.x - 26}, ${node.y - 26})`}>
        <g class="hero-illustration__node" style={{ '--float-delay': `${i * -1.5}s` }}>
          <rect width="52" height="52" rx="16" fill="var(--color-surface-elevated)" stroke="var(--color-border)" />
          <g transform="translate(14 14)" style={{ color: 'var(--color-primary-hover)' }}>
            <Icon name={node.icon} size={24} />
          </g>
        </g>
      </g>
    ))
  }
</svg>

<style>
  .hero-illustration {
    width: 100%;
    height: auto;
  }

  .hero-illustration__node {
    animation: float 6s ease-in-out infinite;
    animation-delay: var(--float-delay, 0s);
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-illustration__node {
      animation: none;
    }
  }
</style>
