---
/**
 * Hero visual: a plain-language business dashboard mockup, shown on a
 * browser window and a phone side by side — something a shop owner or
 * accountant recognizes immediately as "software for my business,
 * everywhere I need it." No code, no developer jargon.
 */
import Icon from '../common/Icon.astro';

const chartBars = [38, 58, 48, 72, 62, 88, 78];
---

<div class="biz-mock">
  <div class="biz-mock__glow" aria-hidden="true"></div>

  <div class="biz-mock__browser" role="img" aria-label="نمایی از یک داشبورد مدیریت فروش با آمار فروش امروز، نمودار هفتگی و سفارش‌های اخیر">
    <div class="biz-mock__titlebar">
      <span class="biz-mock__dot biz-mock__dot--1"></span>
      <span class="biz-mock__dot biz-mock__dot--2"></span>
      <span class="biz-mock__dot biz-mock__dot--3"></span>
      <span class="biz-mock__url">داشبورد فروش</span>
    </div>

    <div class="biz-mock__screen">
      <div class="biz-mock__stat">
        <div>
          <span class="biz-mock__stat-label">فروش امروز</span>
          <strong class="biz-mock__stat-value" data-count-to="12540000" data-suffix=" تومان">۰ تومان</strong>
        </div>
        <span class="biz-mock__badge">۱۸٪ ⬆</span>
      </div>

      <div class="biz-mock__chart" aria-hidden="true">
        {chartBars.map((h, i) => <span style={{ '--h': `${h}%`, '--i': i }}></span>)}
      </div>

      <ul class="biz-mock__list">
        <li>
          <span class="biz-mock__list-icon"><Icon name="cart" size={16} /></span>
          <span class="biz-mock__list-text">سفارش جدید ثبت شد</span>
          <span class="biz-mock__list-value">۴۵۰,۰۰۰ تومان</span>
        </li>
        <li>
          <span class="biz-mock__list-icon biz-mock__list-icon--warn"><Icon name="warehouse" size={16} /></span>
          <span class="biz-mock__list-text">موجودی رو به اتمام</span>
          <span class="biz-mock__list-value">۳ عدد باقی‌مانده</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="biz-mock__phone" role="img" aria-label="همان داشبورد فروش، روی صفحه موبایل">
    <div class="biz-mock__phone-notch"></div>
    <div class="biz-mock__phone-screen">
      <span class="biz-mock__phone-label">فروش امروز</span>
      <strong class="biz-mock__phone-value">۱۲,۵۴۰,۰۰۰</strong>
      <div class="biz-mock__phone-chart" aria-hidden="true">
        {chartBars.slice(0, 5).map((h, i) => <span style={{ '--h': `${h}%`, '--i': i }}></span>)}
      </div>
    </div>
  </div>
</div>

<style>
  .biz-mock {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .biz-mock__glow {
    position: absolute;
    inset: -15%;
    background: radial-gradient(circle at 40% 30%, var(--tone-accent) 0%, transparent 60%);
    opacity: 0.22;
    filter: blur(48px);
    z-index: -1;
  }

  .biz-mock__browser {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .biz-mock__titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-border-hairline);
    background: var(--color-background-alt);
  }

  .biz-mock__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .biz-mock__url {
    margin-inline-start: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
  }

  .biz-mock__screen {
    padding: var(--space-6);
  }

  .biz-mock__stat {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-6);
  }

  .biz-mock__stat-label {
    display: block;
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-1);
  }

  .biz-mock__stat-value {
    font-size: var(--font-size-2xl);
    color: var(--color-text);
  }

  .biz-mock__badge {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-success);
    background: var(--color-success-soft);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
  }

  .biz-mock__chart {
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    height: 84px;
    margin-bottom: var(--space-6);
  }

  .biz-mock__chart span {
    flex: 1;
    height: var(--h);
    border-radius: 6px 6px 2px 2px;
    background: var(--tone-accent-soft);
    transform: scaleY(0);
    transform-origin: bottom;
    animation: biz-bar-grow 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 90ms + 150ms);
  }

  .biz-mock__chart span:nth-child(odd) {
    background: var(--tone-accent);
  }

  .biz-mock__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-hairline);
  }

  .biz-mock__list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-sm);
  }

  .biz-mock__list-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: var(--tone-accent-soft);
    color: var(--tone-accent-hover);
  }

  .biz-mock__list-icon--warn {
    background: rgba(232, 185, 117, 0.14);
    color: var(--color-accent-gold);
  }

  .biz-mock__list-text {
    flex-grow: 1;
    color: var(--color-text-muted);
  }

  .biz-mock__list-value {
    flex-shrink: 0;
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
  }

  .biz-mock__phone {
    position: absolute;
    bottom: calc(-1 * var(--space-6));
    inset-inline-end: -108px;
    width: 120px;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-strong);
    border-radius: 22px;
    box-shadow: var(--shadow-lg);
    padding: var(--space-3) var(--space-3) var(--space-4);
  }

  .biz-mock__phone-notch {
    width: 28px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
    margin: 0 auto var(--space-3);
  }

  .biz-mock__phone-screen {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .biz-mock__phone-label {
    font-size: 0.6rem;
    color: var(--color-text-subtle);
  }

  .biz-mock__phone-value {
    font-size: var(--font-size-sm);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .biz-mock__phone-chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 32px;
  }

  .biz-mock__phone-chart span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 1px 1px;
    background: var(--tone-accent-soft);
    transform: scaleY(0);
    transform-origin: bottom;
    animation: biz-bar-grow 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 90ms + 500ms);
  }

  .biz-mock__phone-chart span:nth-child(odd) {
    background: var(--tone-accent);
  }

  @keyframes biz-bar-grow {
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .biz-mock__chart span,
    .biz-mock__phone-chart span {
      animation: none;
      transform: scaleY(1);
    }
  }

  @media (max-width: 640px) {
    .biz-mock__phone {
      display: none;
    }
  }
</style>

<script>
  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.countTo ?? '0');
    const suffix = el.dataset.suffix ?? '';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = `${target.toLocaleString('fa-IR')}${suffix}`;
      return;
    }

    const duration = 1100;
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = Math.round(target * eased);
      el.textContent = `${value.toLocaleString('fa-IR')}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  document.querySelectorAll<HTMLElement>('[data-count-to]').forEach(animateCount);
</script>
