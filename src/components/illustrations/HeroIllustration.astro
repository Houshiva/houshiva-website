---
/**
 * Hero visual: Houshiva's mark sits at the center with six real services
 * orbiting it on a slowly spinning ring. Hovering (or tapping, on touch) a
 * node brings it into focus and reveals a small live stat + chart for that
 * service — an idle "spotlight" also cycles through them on its own.
 */
import Icon from '../common/Icon.astro';
import Logo from './Logo.astro';
import { services } from '../../data/services';
import { toneForIndex, toneVars } from '../../lib/tones';

const featuredSlugs = ['website-design', 'ecommerce', 'accounting', 'pos', 'crm', 'dashboard'];
const featured = featuredSlugs
  .map((slug) => services.find((s) => s.slug === slug))
  .filter((s): s is (typeof services)[number] => Boolean(s));

const extras: Record<string, { label: string; value: number; suffix: string; bars: number[] }> = {
  'website-design': { label: 'امتیاز عملکرد سایت', value: 96, suffix: '٪', bars: [55, 70, 60, 85, 96] },
  ecommerce: { label: 'فروش این هفته', value: 8400000, suffix: ' تومان', bars: [40, 55, 50, 75, 90] },
  accounting: { label: 'اسناد ثبت‌شده', value: 240, suffix: ' سند', bars: [30, 50, 45, 65, 80] },
  pos: { label: 'تراکنش امروز', value: 58, suffix: ' تراکنش', bars: [45, 60, 55, 80, 70] },
  crm: { label: 'فرصت‌های فعال', value: 12, suffix: ' فرصت', bars: [35, 45, 60, 50, 75] },
  dashboard: { label: 'شاخص‌های زنده', value: 9, suffix: ' شاخص', bars: [50, 65, 55, 90, 85] },
};

const RADIUS = 130;
const nodes = featured.map((service, i) => {
  const angleDeg = -90 + i * (360 / featured.length);
  const angleRad = (angleDeg * Math.PI) / 180;
  return {
    service,
    extra: extras[service.slug],
    x: Math.round(Math.cos(angleRad) * RADIUS),
    y: Math.round(Math.sin(angleRad) * RADIUS),
  };
});
---

<div class="orbit-mock">
  <div class="orbit-mock__glow" aria-hidden="true"></div>

  <div class="orbit-mock__ring">
    <div class="orbit-mock__globe" aria-hidden="true"></div>
    <div class="orbit-mock__spin-ring" aria-hidden="true"></div>
    <div class="orbit-mock__spin-ring orbit-mock__spin-ring--outer" aria-hidden="true"></div>

    {
      nodes.map(({ x, y }) => {
        const angleDeg = (Math.atan2(y, x) * 180) / Math.PI;
        const length = Math.hypot(x, y);
        return (
          <span
            class="orbit-mock__line"
            style={{ width: `${length}px`, transform: `rotate(${angleDeg}deg)` }}
            aria-hidden="true"
          />
        );
      })
    }

    <div class="orbit-mock__center" aria-hidden="true">
      <Logo size={32} withWordmark={false} />
    </div>

    {
      nodes.map(({ service, x, y }, i) => (
        <button
          type="button"
          class:list={['orbit-mock__node', { 'is-active': i === 0 }]}
          style={{ left: `calc(50% + ${x}px)`, top: `calc(50% + ${y}px)`, '--i': i, ...toneVars(toneForIndex(i)) }}
          data-node-index={i}
          aria-label={service.title}
        >
          <span class="orbit-mock__node-float">
            <span class="orbit-mock__node-visual">
              <Icon name={service.icon as any} size={18} />
            </span>
          </span>
        </button>
      ))
    }
  </div>

  <div class="orbit-mock__panel">
    {
      nodes.map(({ service, extra }, i) => (
        <div class:list={['orbit-mock__panel-item', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
          <div class="orbit-mock__panel-main">
            <div class="orbit-mock__panel-icon" style={toneVars(toneForIndex(i))}>
              <Icon name={service.icon as any} size={20} />
            </div>
            <div>
              <h3 class="orbit-mock__panel-title">{service.title}</h3>
              <p class="orbit-mock__panel-desc">{service.shortDescription}</p>
            </div>
          </div>

          {extra && (
            <div class="orbit-mock__widget" style={toneVars(toneForIndex(i))}>
              <span class="orbit-mock__widget-label">{extra.label}</span>
              <strong class="orbit-mock__widget-value" data-count-to={extra.value} data-suffix={extra.suffix}>
                ۰
              </strong>
              <div class="orbit-mock__widget-chart" aria-hidden="true">
                {extra.bars.map((h, bi) => (
                  <span style={{ '--h': `${h}%`, '--i': bi }} />
                ))}
              </div>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <div class="orbit-mock__dots">
    {nodes.map((_, i) => <span class:list={['orbit-mock__dot', { 'is-active': i === 0 }]} data-dot-index={i} />)}
  </div>
</div>

<style>
  .orbit-mock {
    position: relative;
    width: 100%;
    min-width: 0;
  }

  .orbit-mock__glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 50% 35%, var(--tone-accent) 0%, transparent 60%);
    opacity: 0.28;
    filter: blur(64px);
    z-index: -1;
  }

  .orbit-mock__ring {
    position: relative;
    width: min(340px, 100%);
    margin-inline: auto;
  }

  .orbit-mock__ring::before {
    content: '';
    display: block;
    /* Guarantees height = width (a perfect circle) regardless of any
       aspect-ratio quirk under the grid/stretch context above — padding
       percentages are always resolved against the containing block's
       width, in both axes. */
    padding-top: 100%;
  }

  .orbit-mock__globe {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 78%;
    height: 78%;
    border-radius: 50%;
    background:
      radial-gradient(circle at 32% 26%, color-mix(in srgb, var(--tone-accent) 22%, transparent) 0%, transparent 55%),
      radial-gradient(circle at 50% 50%, var(--color-surface-elevated) 0%, var(--color-surface) 72%, var(--color-background-alt) 100%);
    border: 1px solid var(--color-border-hairline);
    box-shadow:
      inset 0 -18px 40px -10px color-mix(in srgb, var(--color-shadow, #000) 12%, transparent),
      inset 0 12px 30px -12px color-mix(in srgb, #fff 30%, transparent),
      0 30px 60px -20px color-mix(in srgb, var(--tone-accent) 30%, transparent);
  }

  .orbit-mock__spin-ring {
    position: absolute;
    inset: 0;
    margin: auto;
    width: calc(100% - 24px);
    height: calc(100% - 24px);
    border: 1.5px dashed var(--color-border-hairline);
    border-radius: 50%;
    animation: orbit-spin 60s linear infinite;
  }

  .orbit-mock__spin-ring--outer {
    width: 100%;
    height: 100%;
    border-style: solid;
    border-width: 1px;
    border-color: var(--color-border-hairline);
    animation-duration: 90s;
    animation-direction: reverse;
    opacity: 0.6;
  }

  .orbit-mock__line {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 0;
    border-top: 1.5px dashed var(--color-border-strong);
    transform-origin: 0 50%;
  }

  .orbit-mock__center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-glow-primary);
    z-index: 2;
  }

  .orbit-mock__node {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 48px;
    height: 48px;
    z-index: 1;
  }

  .orbit-mock__node-float {
    display: block;
    width: 100%;
    height: 100%;
    animation: orbit-node-float 5s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.8s);
  }

  .orbit-mock__node-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      border-color 0.25s ease,
      color 0.25s ease,
      background-color 0.25s ease,
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .orbit-mock__node:hover .orbit-mock__node-visual,
  .orbit-mock__node:focus-visible .orbit-mock__node-visual,
  .orbit-mock__node.is-active .orbit-mock__node-visual {
    border-color: var(--tone-accent);
    color: var(--tone-accent-hover);
    background: var(--tone-accent-soft);
    transform: scale(1.16);
    box-shadow: var(--tone-glow);
  }

  .orbit-mock__panel {
    position: relative;
    min-height: 168px;
    margin-top: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .orbit-mock__panel-item {
    position: absolute;
    inset: 0;
    padding: var(--space-5) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .orbit-mock__panel-item.is-active {
    position: relative;
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .orbit-mock__panel-main {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    min-width: 0;
  }

  .orbit-mock__panel-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tone-accent-soft);
    color: var(--tone-accent-hover);
  }

  .orbit-mock__panel-title {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .orbit-mock__panel-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .orbit-mock__widget {
    flex-shrink: 0;
    width: 132px;
    padding: var(--space-3);
    background: var(--color-background-alt);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-md);
  }

  .orbit-mock__widget-label {
    display: block;
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    margin-bottom: var(--space-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .orbit-mock__widget-value {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    white-space: nowrap;
  }

  .orbit-mock__widget-chart {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 28px;
  }

  .orbit-mock__widget-chart span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 1px 1px;
    background: var(--tone-accent-soft);
    transform: scaleY(0);
    transform-origin: bottom;
    animation: orbit-bar-grow 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 80ms + 100ms);
  }

  .orbit-mock__widget-chart span:nth-child(odd) {
    background: var(--tone-accent);
  }

  .orbit-mock__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-5);
  }

  .orbit-mock__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border-strong);
    cursor: pointer;
    transition:
      background-color 0.25s ease,
      transform 0.25s ease;
  }

  .orbit-mock__dot.is-active {
    background: var(--tone-accent);
    transform: scale(1.5);
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-node-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  @keyframes orbit-bar-grow {
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit-mock__spin-ring,
    .orbit-mock__node-float {
      animation: none;
    }

    .orbit-mock__panel-item {
      transition: opacity 0.2s ease;
      transform: none;
    }

    .orbit-mock__widget-chart span {
      animation: none;
      transform: scaleY(1);
    }
  }

  @media (max-width: 560px) {
    .orbit-mock__panel-item {
      flex-direction: column;
      align-items: stretch;
    }

    .orbit-mock__widget {
      width: auto;
    }

    .orbit-mock__panel {
      min-height: 232px;
    }
  }

  @media (max-width: 420px) {
    .orbit-mock__node {
      width: 38px;
      height: 38px;
    }

    .orbit-mock__center {
      width: 52px;
      height: 52px;
    }
  }
</style>

<script>
  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.countTo ?? '0');
    const suffix = el.dataset.suffix ?? '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      el.textContent = `${target.toLocaleString('fa-IR')}${suffix}`;
      return;
    }

    const duration = 800;
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progress, 3);
      const value = Math.round(target * eased);
      el.textContent = `${value.toLocaleString('fa-IR')}${suffix}`;
      if (progress < 1) requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
  }

  function restartWidgetAnimations(panel: HTMLElement) {
    panel.querySelectorAll<HTMLElement>('.orbit-mock__widget-chart span').forEach((bar) => {
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    });
    panel.querySelectorAll<HTMLElement>('[data-count-to]').forEach(animateCount);
  }

  function initOrbit() {
    const root = document.querySelector<HTMLElement>('.orbit-mock');
    if (!root) return;

    const nodes = Array.from(root.querySelectorAll<HTMLButtonElement>('.orbit-mock__node'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.orbit-mock__panel-item'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.orbit-mock__dot'));
    if (nodes.length === 0) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    function activate(index: number) {
      current = (index + nodes.length) % nodes.length;
      nodes.forEach((n, i) => n.classList.toggle('is-active', i === current));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));

      panels.forEach((p, i) => {
        const active = i === current;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-hidden', String(!active));
        if (active) restartWidgetAnimations(p);
      });
    }

    function stopRotation() {
      if (timer) clearInterval(timer);
      timer = undefined;
    }

    function startRotation() {
      if (reduceMotion) return;
      stopRotation();
      timer = setInterval(() => activate(current + 1), 4000);
    }

    nodes.forEach((node, i) => {
      node.addEventListener('mouseenter', () => {
        activate(i);
        stopRotation();
      });
      node.addEventListener('focus', () => {
        activate(i);
        stopRotation();
      });
      node.addEventListener('click', () => activate(i));
    });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        activate(i);
        startRotation();
      });
    });

    root.addEventListener('mouseleave', startRotation);

    activate(0);
    startRotation();
  }

  document.addEventListener('astro:page-load', initOrbit);
</script>
