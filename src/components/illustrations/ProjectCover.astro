---
/**
 * Abstract per-category cover art for portfolio cards — used instead of
 * generic stock screenshots when a real project image isn't available yet.
 */
export interface Props {
  variant: 'website' | 'store' | 'software' | 'crm' | 'pos' | 'dashboard';
  class?: string;
}

const { variant, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 400 240"
  fill="none"
  role="img"
  aria-hidden="true"
>
  <rect width="400" height="240" fill="var(--color-surface)" />

  {(variant === 'website' || variant === 'software') && (
    <>
      <rect x="24" y="24" width="352" height="192" rx="12" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <circle cx="46" cy="46" r="4" fill="var(--color-text-subtle)" />
      <circle cx="60" cy="46" r="4" fill="var(--color-text-subtle)" />
      <circle cx="74" cy="46" r="4" fill="var(--color-text-subtle)" />
      <rect x="24" y="62" width="352" height="1" fill="var(--color-border)" />
      <rect x="48" y="90" width="140" height="14" rx="4" fill="var(--color-text-subtle)" opacity="0.5" />
      <rect x="48" y="114" width="220" height="10" rx="4" fill="var(--color-border-strong)" />
      <rect x="48" y="132" width="180" height="10" rx="4" fill="var(--color-border-strong)" />
      <rect x="48" y="160" width="96" height="30" rx="8" fill="var(--color-primary)" opacity="0.85" />
    </>
  )}

  {variant === 'store' && (
    <>
      <rect x="40" y="34" width="90" height="90" rx="10" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <rect x="155" y="34" width="90" height="90" rx="10" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <rect x="270" y="34" width="90" height="90" rx="10" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <rect x="60" y="54" width="50" height="8" rx="4" fill="var(--color-border-strong)" />
      <rect x="60" y="68" width="34" height="8" rx="4" fill="var(--color-primary)" opacity="0.8" />
      <rect x="40" y="150" width="320" height="56" rx="12" fill="var(--color-primary)" opacity="0.14" />
      <circle cx="66" cy="178" r="14" fill="var(--color-primary)" />
      <rect x="92" y="170" width="180" height="8" rx="4" fill="var(--color-border-strong)" />
      <rect x="92" y="184" width="120" height="8" rx="4" fill="var(--color-text-subtle)" opacity="0.5" />
    </>
  )}

  {variant === 'crm' && (
    <>
      {[0, 1, 2, 3].map((row) => (
        <g transform={`translate(40 ${34 + row * 46})`}>
          <circle cx="16" cy="16" r="16" fill="var(--color-primary)" opacity={0.9 - row * 0.15} />
          <rect x="46" y="6" width="180" height="9" rx="4" fill="var(--color-border-strong)" />
          <rect x="46" y="21" width="120" height="8" rx="4" fill="var(--color-text-subtle)" opacity="0.5" />
          <rect x="300" y="8" width="60" height="18" rx="9" fill="var(--color-primary-soft)" />
        </g>
      ))}
    </>
  )}

  {variant === 'pos' && (
    <>
      <rect x="130" y="28" width="140" height="184" rx="14" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <rect x="148" y="48" width="104" height="60" rx="8" fill="var(--color-primary)" opacity="0.16" />
      <rect x="158" y="60" width="60" height="8" rx="4" fill="var(--color-primary)" />
      <rect x="158" y="76" width="40" height="8" rx="4" fill="var(--color-border-strong)" />
      {[0, 1, 2].map((r) =>
        [0, 1, 2].map((c) => (
          <rect
            x={150 + c * 36}
            y={122 + r * 28}
            width="28"
            height="20"
            rx="5"
            fill="var(--color-surface-elevated)"
            stroke="var(--color-border)"
          />
        ))
      )}
    </>
  )}

  {variant === 'dashboard' && (
    <>
      <rect x="28" y="28" width="160" height="82" rx="12" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <rect x="44" y="44" width="70" height="9" rx="4" fill="var(--color-text-subtle)" opacity="0.5" />
      <rect x="44" y="66" width="50" height="24" rx="6" fill="var(--color-primary)" opacity="0.85" />
      <rect x="200" y="28" width="172" height="82" rx="12" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <polyline points="216,90 244,68 268,80 296,50 324,64 352,42" fill="none" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      <rect x="28" y="122" width="344" height="90" rx="12" fill="var(--color-background-alt)" stroke="var(--color-border)" />
      <rect x="48" y="150" width="20" height="42" rx="4" fill="var(--color-primary-soft)" />
      <rect x="78" y="134" width="20" height="58" rx="4" fill="var(--color-primary)" />
      <rect x="108" y="160" width="20" height="32" rx="4" fill="var(--color-primary-soft)" />
      <rect x="138" y="144" width="20" height="48" rx="4" fill="var(--color-primary)" />
      <rect x="168" y="156" width="20" height="36" rx="4" fill="var(--color-primary-soft)" />
    </>
  )}
</svg>
