---
import SectionTitle from '../common/SectionTitle.astro';
import Button from '../common/Button.astro';
import Icon from '../common/Icon.astro';
import { tools } from '../../data/tools';
import { toneForIndex, toneVars } from '../../lib/tones';
---

<section class="section tools-preview">
  <div class="container">
    <div class="tools-preview__header">
      <SectionTitle
        eyebrow="ابزارها"
        title="چند ابزار رایگان، همین حالا آماده استفاده"
        description="از رزومه‌ساز تا ابزار PDF؛ بدون ثبت‌نام و کاملاً رایگان."
      />
      <Button href="/tools" variant="secondary">مشاهده همه ابزارها</Button>
    </div>
  </div>

  <div class="tools-preview__marquee">
    <div class="tools-preview__track">
      {
        [...tools, ...tools].map((tool, index) => (
          <a
            href={`/tools/${tool.slug}`}
            class="tools-preview__chip"
            style={toneVars(toneForIndex(index))}
            aria-hidden={index >= tools.length ? 'true' : undefined}
            tabindex={index >= tools.length ? -1 : undefined}
          >
            <span class="tools-preview__chip-icon">
              <Icon name={tool.icon} size={18} />
            </span>
            {tool.title}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tools-preview {
    overflow: hidden;
  }

  .tools-preview__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: var(--space-10);
  }

  .tools-preview__header :global(.section-title) {
    margin-bottom: 0;
  }

  .tools-preview__marquee {
    width: 100%;
    overflow: hidden;
    /*
     * Forced to LTR box-flow: the marquee math (track rest position anchored
     * at the start edge, animating toward -50%) only tiles seamlessly when
     * that start edge is the left edge. Under the page's real RTL direction
     * the track instead rests anchored at the right edge, so animating the
     * same -50% retreats its trailing edge past the container's right side
     * and exposes empty space there once a full cycle plays out. Persian
     * text still shapes correctly regardless of container direction.
     */
    direction: ltr;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .tools-preview__track {
    display: flex;
    width: max-content;
    gap: var(--space-4);
    animation: tools-marquee 32s linear infinite;
  }

  .tools-preview__marquee:hover .tools-preview__track {
    animation-play-state: paused;
  }

  .tools-preview__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    transition:
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .tools-preview__chip:hover {
    border-color: var(--tone-accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .tools-preview__chip-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--tone-accent-soft);
    color: var(--tone-accent-hover);
    flex-shrink: 0;
  }

  @keyframes tools-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 720px) {
    .tools-preview__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools-preview__track {
      animation: none;
      overflow-x: auto;
      padding-bottom: var(--space-3);
    }
  }
</style>
