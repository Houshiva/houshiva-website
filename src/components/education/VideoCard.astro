---
import ProjectCover from '../illustrations/ProjectCover.astro';
import Icon from '../common/Icon.astro';
import type { Video } from '../../data/videos';

export interface Props {
  video: Video;
}

const { video } = Astro.props;
---

<article class="video-card">
  <a href={`/education/${video.slug}`} class="video-card__cover">
    <ProjectCover variant={video.poster} />
    <span class="video-card__play"><Icon name="play" size={20} /></span>
    <span class="video-card__duration">{video.duration}</span>
  </a>
  <div class="video-card__body">
    <span class="video-card__category">{video.category}</span>
    <h3><a href={`/education/${video.slug}`}>{video.title}</a></h3>
    <p>{video.description}</p>
  </div>
</article>

<style>
  .video-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      border-color var(--transition-base),
      transform var(--transition-base);
  }

  .video-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

  .video-card__cover {
    position: relative;
    display: block;
    aspect-ratio: 400 / 240;
  }

  .video-card__cover :global(svg) {
    width: 100%;
    height: 100%;
  }

  .video-card__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 52px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: rgba(10, 10, 16, 0.6);
    color: #fff;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .video-card__play :global(svg) {
    margin-inline-start: 2px;
  }

  .video-card:hover .video-card__play {
    background: var(--color-primary);
    transform: scale(1.08);
  }

  .video-card__duration {
    position: absolute;
    bottom: var(--space-2);
    inset-inline-end: var(--space-2);
    font-size: var(--font-size-xs);
    color: #fff;
    background: rgba(10, 10, 16, 0.75);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
  }

  .video-card__body {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .video-card__category {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-primary-hover);
  }

  .video-card__body p {
    font-size: var(--font-size-sm);
  }

  .video-card__body h3 a {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .video-card__body h3 a:hover {
    color: var(--color-primary-hover);
  }
</style>
