---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import WhatsAppButton from '../components/common/WhatsAppButton.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { site } from '../data/site';
import '../styles/global.css';

export interface Breadcrumb {
  label: string;
  path: string;
}

export interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'video.other';
  ogImage?: string;
  ogImageAlt?: string;
  structuredData?: Record<string, unknown>[];
  breadcrumbs?: Breadcrumb[];
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  ogType = 'website',
  ogImage = '/og-image.png',
  ogImageAlt = 'هوشیوا — راهکارهای نرم‌افزاری برای رشد هوشمند کسب‌وکار',
  structuredData = [],
  breadcrumbs,
} = Astro.props;

const pageTitle = path === '/' ? title : `${title} | هوشیوا`;
const canonicalUrl = new URL(path, site.url).toString();
const ogImageUrl = new URL(ogImage, site.url).toString();

const resolvedBreadcrumbs: Breadcrumb[] = breadcrumbs ?? (path === '/' ? [] : [{ label: title, path }]);

const breadcrumbSchema =
  resolvedBreadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'صفحه اصلی', item: site.url },
          ...resolvedBreadcrumbs.map((crumb, index) => ({
            '@type': 'ListItem',
            position: index + 2,
            name: crumb.label,
            item: new URL(crumb.path, site.url).toString(),
          })),
        ],
      }
    : null;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'هوشیوا',
  alternateName: 'Houshiva',
  url: site.url,
  logo: new URL('/brand/houshiva-logo.png', site.url).toString(),
  description: site.description,
  email: site.contact.email,
  telephone: site.contact.phones[0]?.href,
  sameAs: site.social.map((s) => s.url),
};

const allSchemas = [organizationSchema, ...(breadcrumbSchema ? [breadcrumbSchema] : []), ...structuredData];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a10" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — مقالات آموزشی`} href="/rss.xml" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="هوشیوا" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="هوشیوا" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      allSchemas.map((schema) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }

    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">رفتن به محتوای اصلی</a>
    <Header transition:persist />
    <Breadcrumbs items={resolvedBreadcrumbs} />
    <div class="route-progress" id="route-progress" aria-hidden="true"></div>
    <main id="main-content" transition:name="main-content">
      <slot />
    </main>
    <Footer transition:persist />
    <WhatsAppButton />

    <script>
      function initReveal() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        document.documentElement.classList.add('js-reveal');

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
        );

        const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)'));

        // Stagger delay must reflect actual visual row, not DOM order: a flat
        // page-wide (or even per-parent) counter can put a card early in a
        // row's index sequence right after a leftover from a previous section
        // or a previous row, so it lags behind — or jumps ahead of — its own
        // row-mates. Group by parent, then by rendered offsetTop (= row), so
        // each row gets its own clean 0, 70, 140... sequence.
        const groups = new Map<Element, HTMLElement[]>();
        revealEls.forEach((el) => {
          const parent = el.parentElement;
          if (!parent) return;
          if (!groups.has(parent)) groups.set(parent, []);
          groups.get(parent)!.push(el);
        });

        groups.forEach((siblings) => {
          const rows = new Map<number, HTMLElement[]>();
          siblings.forEach((el) => {
            const top = Math.round(el.offsetTop);
            if (!rows.has(top)) rows.set(top, []);
            rows.get(top)!.push(el);
          });
          rows.forEach((rowEls) => {
            rowEls.forEach((el, i) => {
              el.style.setProperty('--reveal-delay', `${Math.min(i, 5) * 70}ms`);
            });
          });
        });

        revealEls.forEach((el) => observer.observe(el));
      }

      document.addEventListener('astro:page-load', initReveal);
    </script>

    <script>
      // Visible feedback that a page navigation is actually happening — a
      // thin top bar that grows on astro:before-preparation (nav started),
      // jumps to full on astro:after-swap (new content is in), then fades.
      const bar = document.getElementById('route-progress');
      let fadeTimer: ReturnType<typeof setTimeout> | undefined;

      document.addEventListener('astro:before-preparation', () => {
        if (!bar) return;
        clearTimeout(fadeTimer);
        bar.classList.remove('is-done');
        bar.classList.add('is-loading');
        // force reflow so the 0 -> partial transition always plays, even
        // if a previous navigation left it mid-animation
        void bar.offsetWidth;
        bar.style.transform = 'scaleX(0.35)';
      });

      document.addEventListener('astro:after-swap', () => {
        if (!bar) return;
        bar.style.transform = 'scaleX(1)';
      });

      document.addEventListener('astro:page-load', () => {
        if (!bar) return;
        fadeTimer = setTimeout(() => {
          bar.classList.add('is-done');
          bar.classList.remove('is-loading');
          bar.style.transform = 'scaleX(0)';
        }, 200);
      });
    </script>
  </body>
</html>
