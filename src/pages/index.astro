import Process from '../components/home/Process.astro';
import PortfolioPreview from '../components/home/PortfolioPreview.astro';
import CtaSection from '../components/common/CtaSection.astro';
---

<MainLayout
  title="هوشیوا | راهکارهای نرم‌افزاری برای رشد هوشمند کسب‌وکار"
  description="هوشیوا طراحی سایت، فروشگاه اینترنتی، نرم‌افزار اختصاصی، حسابداری، صندوق فروش، CRM، انبار و اتوماسیون کسب‌وکار را متناسب با نیاز واقعی شما طراحی و توسعه می‌دهد."
  path="/"
>
  <Hero />
  <ServicesPreview />
  <WhyHoushiva />
  <Process />
  <PortfolioPreview />
  <CtaSection />
</MainLayout>
