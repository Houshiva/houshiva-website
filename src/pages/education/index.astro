---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import SectionTitle from '../../components/common/SectionTitle.astro';
import ArticleCard from '../../components/education/ArticleCard.astro';
import VideoCard from '../../components/education/VideoCard.astro';
import CtaSection from '../../components/common/CtaSection.astro';
import GradientMesh from '../../components/common/GradientMesh.astro';
import { videos } from '../../data/videos';
import { articleCategories, slugForCategory } from '../../data/articleCategories';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<MainLayout
  title="آموزش"
  description="مقالات و ویدیوهای آموزشی هوشیوا درباره نرم‌افزار، حسابداری، فروشگاه‌داری و مدیریت کسب‌وکار — برای تصمیم‌گیری بهتر درباره دیجیتالی‌کردن کسب‌وکارتان."
  path="/education"
>
  <section class="section education-page tone-teal">
    <GradientMesh variant="hero" secondary="var(--color-primary)" />
    <div class="container">
      <SectionTitle
        as="h1"
        eyebrow="آموزش"
        title="مطالبی که به تصمیم‌گیری شما کمک می‌کند"
        description="مقاله و ویدیوهای کوتاه درباره نرم‌افزار و مدیریت کسب‌وکار؛ نوشته‌شده بر اساس تجربه واقعی پروژه‌ها، نه برای پر کردن صفحه."
        data-reveal
      />

      <div class="education-filter">
        <input type="radio" name="education-filter" id="filter-content-all" class="visually-hidden" checked />
        <input type="radio" name="education-filter" id="filter-content-article" class="visually-hidden" />
        <input type="radio" name="education-filter" id="filter-content-video" class="visually-hidden" />

        <input type="radio" name="article-category-filter" id="filter-topic-all" class="visually-hidden" checked />
        {
          articleCategories.map((_, i) => (
            <input type="radio" name="article-category-filter" id={`filter-topic-${i}`} class="visually-hidden" />
          ))
        }

        <div class="education-filter__tabs">
          <label for="filter-content-all">همه</label>
          <label for="filter-content-article">مقاله</label>
          <label for="filter-content-video">ویدیو</label>
        </div>

        <div class="education-filter__grid">
          <div class="education-filter__group education-filter__group--articles">
            <div class="education-filter__topic-tabs">
              <label for="filter-topic-all">همه موضوعات</label>
              {articleCategories.map((cat, i) => <label for={`filter-topic-${i}`}>{cat.name}</label>)}
            </div>

            <div class="education-filter__articles-grid">
              {
                articles.map((article) => (
                  <div
                    class:list={['education-filter__item', 'cat-article', slugForCategory(article.data.category)]}
                    data-reveal
                  >
                    <ArticleCard
                      slug={article.id}
                      title={article.data.title}
                      description={article.data.description}
                      category={article.data.category}
                      readingTime={article.data.readingTime}
                      publishDate={article.data.publishDate}
                    />
                  </div>
                ))
              }
            </div>
          </div>

          <div class="education-filter__group education-filter__group--videos">
            {
              videos.map((video) => (
                <div class="education-filter__item cat-video" data-reveal>
                  <VideoCard video={video} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaSection class="tone-teal" />
</MainLayout>

<style>
  .education-page {
    position: relative;
    z-index: 0;
  }

  .education-filter__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-10);
  }

  .education-filter__tabs label {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-5);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .education-filter__tabs label:hover {
    border-color: var(--tone-accent);
    color: var(--color-text);
  }

  .education-filter__group--articles {
    margin-bottom: var(--space-10);
  }

  .education-filter__topic-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .education-filter__topic-tabs label {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-4);
    cursor: pointer;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .education-filter__topic-tabs label:hover {
    color: var(--color-text);
  }

  .education-filter__articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .education-filter__group--videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  /* Active tab + filtering — CSS-only, no JavaScript */
  #filter-content-all:checked ~ .education-filter__tabs label[for='filter-content-all'],
  #filter-content-article:checked ~ .education-filter__tabs label[for='filter-content-article'],
  #filter-content-video:checked ~ .education-filter__tabs label[for='filter-content-video'] {
    color: var(--tone-accent-hover);
    border-color: var(--tone-accent);
    background: var(--tone-accent-soft);
  }

  #filter-content-video:checked ~ .education-filter__grid .education-filter__group--articles,
  #filter-content-article:checked ~ .education-filter__grid .education-filter__group--videos {
    display: none;
  }

  /* Topic filter (articles only) — same CSS-only pattern */
  #filter-topic-all:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-all'],
  #filter-topic-0:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-0'],
  #filter-topic-1:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-1'],
  #filter-topic-2:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-2'],
  #filter-topic-3:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-3'],
  #filter-topic-4:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-4'],
  #filter-topic-5:checked ~ .education-filter__grid .education-filter__topic-tabs label[for='filter-topic-5'] {
    color: var(--tone-accent-hover);
    border-color: var(--tone-accent);
    background: var(--tone-accent-soft);
  }

  #filter-topic-0:checked ~ .education-filter__grid .education-filter__articles-grid .education-filter__item:not(.cat-0),
  #filter-topic-1:checked ~ .education-filter__grid .education-filter__articles-grid .education-filter__item:not(.cat-1),
  #filter-topic-2:checked ~ .education-filter__grid .education-filter__articles-grid .education-filter__item:not(.cat-2),
  #filter-topic-3:checked ~ .education-filter__grid .education-filter__articles-grid .education-filter__item:not(.cat-3),
  #filter-topic-4:checked ~ .education-filter__grid .education-filter__articles-grid .education-filter__item:not(.cat-4),
  #filter-topic-5:checked ~ .education-filter__grid .education-filter__articles-grid .education-filter__item:not(.cat-5) {
    display: none;
  }
</style>
