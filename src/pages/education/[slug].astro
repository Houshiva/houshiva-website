---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/common/Icon.astro';
import CtaSection from '../../components/common/CtaSection.astro';
import ProtectedVideoPlayer from '../../components/education/ProtectedVideoPlayer.astro';
import { videos } from '../../data/videos';
import { site } from '../../data/site';
import type { Video } from '../../data/videos';

export interface Props {
  type: 'article' | 'video';
  article?: CollectionEntry<'articles'>;
  video?: Video;
}

export async function getStaticPaths() {
  const articles = await getCollection('articles');

  const articlePaths = articles.map((article) => ({
    params: { slug: article.id },
    props: { type: 'article' as const, article },
  }));

  const videoPaths = videos.map((video) => ({
    params: { slug: video.slug },
    props: { type: 'video' as const, video },
  }));

  return [...articlePaths, ...videoPaths];
}

const { type, article, video } = Astro.props;

const breadcrumbs = [
  { label: 'آموزش', path: '/education' },
  { label: type === 'article' ? article!.data.title : video!.title, path: Astro.url.pathname },
];

let Content;
if (type === 'article' && article) {
  ({ Content } = await render(article));
}

const structuredData =
  type === 'article' && article
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'Article',
          headline: article.data.title,
          description: article.data.description,
          datePublished: article.data.publishDate.toISOString(),
          inLanguage: 'fa-IR',
          author: { '@type': 'Organization', name: 'هوشیوا' },
          publisher: { '@type': 'Organization', name: 'هوشیوا', url: site.url },
        },
      ]
    : video
      ? [
          {
            '@context': 'https://schema.org',
            '@type': 'VideoObject',
            name: video.title,
            description: video.description,
            thumbnailUrl: new URL('/og-image.png', site.url).toString(),
            uploadDate: new Date().toISOString(),
            ...(video.videoUrl ? { contentUrl: video.videoUrl } : {}),
          },
        ]
      : [];
---

<MainLayout
  title={type === 'article' ? article!.data.title : video!.title}
  description={type === 'article' ? article!.data.description : video!.description}
  path={`/education/${Astro.params.slug}`}
  ogType={type === 'article' ? 'article' : 'video.other'}
  structuredData={structuredData}
  breadcrumbs={breadcrumbs}
>
  <article class="section content-detail tone-teal">
    <div class="container container--narrow">
      <a href="/education" class="content-detail__back">
        <Icon name="chevron-start" size={16} />
        بازگشت به آموزش
      </a>

      {
        type === 'article' && article && (
          <>
            <span class="content-detail__category">{article.data.category}</span>
            <h1 class="text-balance">{article.data.title}</h1>
            <div class="content-detail__meta">
              <span>
                {new Intl.DateTimeFormat('fa-IR', { year: 'numeric', month: 'long', day: 'numeric' }).format(
                  article.data.publishDate
                )}
              </span>
              <span aria-hidden="true">·</span>
              <span>{article.data.readingTime} مطالعه</span>
            </div>
            <div class="content-detail__body">{Content && <Content />}</div>
          </>
        )
      }

      {
        type === 'video' && video && (
          <>
            <span class="content-detail__category">{video.category}</span>
            <h1 class="text-balance">{video.title}</h1>
            <p class="content-detail__lead">{video.description}</p>
            <ProtectedVideoPlayer video={video} />
          </>
        )
      }
    </div>
  </article>

  <CtaSection
    title="سؤالی درباره نرم‌افزار کسب‌وکارتان دارید؟"
    description="اگر بعد از خواندن یا دیدن این محتوا سؤالی برایتان پیش آمده، خوشحال می‌شویم در یک جلسه مشاوره رایگان پاسخ بدهیم."
    class="tone-teal"
  />
</MainLayout>

<style>
  .content-detail {
    padding-bottom: var(--space-16);
  }

  .content-detail__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .content-detail__back:hover {
    color: var(--tone-accent-hover);
  }

  .content-detail__back :global(svg) {
    transform: scaleX(-1);
  }

  .content-detail__category {
    display: inline-block;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--tone-accent-hover);
    background: var(--tone-accent-soft);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-4);
  }

  .content-detail h1 {
    margin-bottom: var(--space-4);
  }

  .content-detail__meta {
    display: flex;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border-hairline);
  }

  .content-detail__lead {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-8);
  }

  .content-detail__body {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-normal);
    color: var(--color-text-muted);
  }

  .content-detail__body :global(h2) {
    font-size: var(--font-size-2xl);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }

  .content-detail__body :global(h3) {
    font-size: var(--font-size-xl);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .content-detail__body :global(p) {
    margin-bottom: var(--space-5);
  }

  .content-detail__body :global(ul),
  .content-detail__body :global(ol) {
    margin-bottom: var(--space-5);
    padding-inline-start: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .content-detail__body :global(ul) {
    list-style: disc;
  }

  .content-detail__body :global(ol) {
    list-style: decimal;
  }

  .content-detail__body :global(strong) {
    color: var(--color-text);
  }

  .content-detail__body :global(code) {
    font-family: 'Consolas', 'Vazirmatn', monospace;
    font-size: 0.875em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.1em 0.4em;
  }

  .content-detail__body :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-bottom: var(--space-5);
    overflow-x: auto;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-normal);
  }

  .content-detail__body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .content-detail__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
    font-size: var(--font-size-sm);
  }

  .content-detail__body :global(th),
  .content-detail__body :global(td) {
    text-align: start;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
  }

  .content-detail__body :global(th) {
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: var(--font-weight-semibold);
  }

  .content-detail__body :global(blockquote) {
    border-inline-start: 3px solid var(--tone-accent);
    padding-inline-start: var(--space-5);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
</style>
