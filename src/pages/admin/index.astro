---
/**
 * Admin home (/admin): visit statistics, deploy status, content editor entry
 * point and quick links. A static page — it holds no secrets: editing goes
 * through the CMS (GitHub token), and the Umami share link is kept only in
 * this browser's localStorage.
 */
import { getCollection } from 'astro:content';
import Icon from '../../components/common/Icon.astro';
import type { IconName } from '../../components/common/Icon.astro';
import { projects } from '../../data/projects';
import { services } from '../../data/services';
import { videos } from '../../data/videos';
import { site } from '../../data/site';
import '../../styles/global.css';

const articles = await getCollection('articles');
const builtAt = new Date();
const repo = 'Houshiva/houshiva-website';
const hasUmami = Boolean(site.analytics.umamiWebsiteId);

const stats: { label: string; value: number; icon: IconName; href: string }[] = [
  { label: 'نمونه‌کار', value: projects.length, icon: 'layers', href: '/portfolio' },
  { label: 'خدمت', value: services.length, icon: 'spark', href: '/services' },
  { label: 'مقاله', value: articles.length, icon: 'book', href: '/education' },
  { label: 'ویدیو', value: videos.length, icon: 'video', href: '/education' },
];

const links: { label: string; description: string; href: string; icon: IconName }[] = [
  { label: 'درخواست‌های مشاوره', description: 'پیام‌های فرم تماس در Web3Forms', href: 'https://app.web3forms.com/', icon: 'mail' },
  { label: 'Google Search Console', description: 'وضعیت سایت در گوگل و درخواست ایندکس', href: 'https://search.google.com/search-console', icon: 'target' },
  { label: 'آمار در Umami', description: 'داشبورد کامل آمار بازدید', href: 'https://cloud.umami.is/', icon: 'trending-up' },
  { label: 'انتشار و قیمت‌ها', description: 'اجرای دستی انتشار سایت و به‌روزرسانی قیمت‌ها', href: `https://github.com/${repo}/actions/workflows/deploy.yml`, icon: 'refresh' },
  { label: 'Cloudflare', description: 'دامنه و DNS', href: 'https://dash.cloudflare.com/', icon: 'cloud' },
  { label: 'کد سایت در گیت‌هاب', description: 'تاریخچه‌ی همه‌ی تغییرات', href: `https://github.com/${repo}`, icon: 'code' },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0a10" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>پنل مدیریت | هوشیوا</title>
  </head>
  <body>
    <div class="admin-login" id="admin-login">
      <form class="admin-login__card" id="admin-login-form" hidden>
        <img src="/favicon.png" alt="" width="44" height="44" />
        <h1>ورود به پنل مدیریت</h1>
        <p>هوشیوا</p>
        <label>
          ایمیل
          <input type="email" id="admin-email" autocomplete="username" dir="ltr" required />
        </label>
        <label>
          رمز عبور
          <input type="password" id="admin-password" autocomplete="current-password" dir="ltr" required />
        </label>
        <p class="admin-login__error" id="admin-login-error" hidden>ایمیل یا رمز عبور اشتباه است.</p>
        <button type="submit" class="admin__btn" id="admin-login-submit">ورود</button>
      </form>
      <p class="admin-login__card" id="admin-login-off" hidden>
        پنل مدیریت هنوز فعال نشده است: ایمیل و رمز عبور مدیر (ADMIN_EMAIL و ADMIN_PASSWORD) در تنظیمات گیت‌هاب ثبت نشده‌اند.
      </p>
    </div>

    <div id="admin-root"></div>
    <script is:inline type="application/json" id="admin-payload"></script>

    {/* Everything between these markers is encrypted at build time (integrations/admin-lock.mjs). */}
    <i hidden data-admin-start></i>
    <div class="admin">
      <header class="admin__top">
        <div>
          <p class="admin__eyebrow">پنل مدیریت</p>
          <h1>سلام، به پنل هوشیوا خوش آمدید</h1>
          <p class="admin__sub">
            آخرین انتشار سایت: <span data-date={builtAt.toISOString()}></span>
          </p>
        </div>
        <div class="admin__top-actions">
          <a class="admin__btn admin__btn--ghost" href="/">
            مشاهده‌ی سایت
            <Icon name="chevron-start" size={16} />
          </a>
          <button type="button" class="admin__btn admin__btn--ghost" id="admin-logout">خروج</button>
        </div>
      </header>

      <section class="admin__stats">
        {
          stats.map((s) => (
            <a class="admin__stat" href={s.href} target="_blank">
              <span class="admin__stat-icon"><Icon name={s.icon} size={20} /></span>
              <b>{s.value.toLocaleString('fa-IR')}</b>
              <span>{s.label}</span>
            </a>
          ))
        }
      </section>

      <div class="admin__grid">
        <section class="admin__card admin__card--edit">
          <div class="admin__card-head">
            <span class="admin__card-icon"><Icon name="brackets" size={22} /></span>
            <div>
              <h2>ویرایش محتوای سایت</h2>
              <p>نمونه‌کارها، خدمات، مقاله‌ها، ویدیوها، تیم، اطلاعات تماس، شبکه‌های اجتماعی و فهرست قیمت‌ها</p>
            </div>
          </div>
          <p class="admin__note">
            بعد از هر «ذخیره» (Save)، تغییر در گیت‌هاب ثبت می‌شود و سایت حدود یک دقیقه بعد خودکار به‌روز می‌شود. وضعیتش را در
            کادر «انتشارها» همین صفحه می‌بینید.
          </p>
          <a class="admin__btn" href="/admin/cms/">
            ورود به ویرایشگر
            <Icon name="chevron-start" size={16} />
          </a>
        </section>

        <section class="admin__card">
          <div class="admin__card-head">
            <span class="admin__card-icon"><Icon name="refresh" size={22} /></span>
            <div>
              <h2>انتشارها</h2>
              <p>آخرین به‌روزرسانی‌های سایت (هر ذخیره، هر تغییر و به‌روزرسانی خودکار قیمت‌ها)</p>
            </div>
          </div>
          <ul class="admin__runs" id="runs" data-repo={repo}>
            <li class="admin__muted">در حال دریافت…</li>
          </ul>
          <a class="admin__link" href={`https://github.com/${repo}/actions`} target="_blank" rel="noopener">
            همه‌ی انتشارها در گیت‌هاب
            <Icon name="chevron-start" size={14} />
          </a>
        </section>
      </div>

      <section class="admin__card" data-embed="houshiva-admin-gsc-embed">
        <div class="admin__card-head">
          <span class="admin__card-icon"><Icon name="target" size={22} /></span>
          <div>
            <h2>جست‌وجوی گوگل</h2>
            <p>از گذشته تا امروز: چند بار در نتایج گوگل دیده شدید، چند کلیک گرفتید و با چه کلمه‌هایی پیدایتان کردند</p>
          </div>
          <button type="button" class="admin__btn admin__btn--ghost admin__btn--small js-embed-reset" hidden>تغییر لینک</button>
        </div>

        <div class="js-embed-view" hidden>
          <iframe class="admin__embed js-embed-frame" title="جست‌وجوی گوگل" loading="lazy" allowfullscreen></iframe>
          <a class="admin__link js-embed-open" target="_blank" rel="noopener">
            باز کردن در صفحه‌ی جدا
            <Icon name="chevron-start" size={14} />
          </a>
        </div>

        <div class="admin__setup js-embed-setup">
          <p class="admin__muted">
            داده‌های Search Console را با ابزار رایگان گوگل به نام Looker Studio به یک گزارش تبدیل می‌کنیم و همان گزارش این‌جا نمایش
            داده می‌شود (یک بار، حدود ۵ دقیقه):
          </p>
          <ol>
            <li>
              با همان حساب گوگلی که Search Console را دارد، وارد{' '}
              <a href="https://lookerstudio.google.com/" target="_blank" rel="noopener">lookerstudio.google.com</a> شوید.
            </li>
            <li>
              «Create ← Report» را بزنید، از فهرست منبع‌ها <b>Search Console</b> را انتخاب کنید، سایت <b>houshiva.ir</b> و بعد
              «Site Impression» را انتخاب و «Add» کنید.
            </li>
            <li>
              نمودار و جدول دلخواه را اضافه کنید (مثلاً «Time series» برای کلیک‌ها و «Table» با ستون «Query» برای کلمه‌ها).
            </li>
            <li>از منوی «File ← Embed report»، گزینه‌ی «Enable embedding» را روشن کنید و «Embed URL» را کپی کنید.</li>
            <li>از دکمه‌ی «Share»، دسترسی را روی «Anyone with the link can view» بگذارید و لینک را این‌جا وارد کنید:</li>
          </ol>
          <form class="admin__form js-embed-form">
            <input type="url" placeholder="https://lookerstudio.google.com/embed/reporting/..." dir="ltr" required />
            <button type="submit" class="admin__btn">نمایش گزارش</button>
          </form>
          <p class="admin__muted">این لینک فقط در همین مرورگر ذخیره می‌شود و در سایت منتشر نمی‌شود.</p>
        </div>
      </section>

      <section class="admin__card" data-embed="houshiva-admin-umami-share">
        <div class="admin__card-head">
          <span class="admin__card-icon"><Icon name="trending-up" size={22} /></span>
          <div>
            <h2>آمار بازدید</h2>
            <p>از زمان فعال‌سازی به بعد: همه‌ی بازدیدها، صفحه‌های پربازدید و اینکه از کجا آمده‌اند</p>
          </div>
          <button type="button" class="admin__btn admin__btn--ghost admin__btn--small js-embed-reset" hidden>تغییر لینک</button>
        </div>

        <div class="js-embed-view" hidden>
          <iframe class="admin__embed js-embed-frame" title="آمار بازدید" loading="lazy"></iframe>
          <a class="admin__link js-embed-open" target="_blank" rel="noopener">
            باز کردن در صفحه‌ی جدا
            <Icon name="chevron-start" size={14} />
          </a>
        </div>

        <div class="admin__setup js-embed-setup">
          {
            !hasUmami && (
              <p class="admin__warn">
                آمارگیری هنوز روی سایت فعال نیست. مراحل زیر را یک بار انجام دهید.
              </p>
            )
          }
          <ol>
            <li>در <a href="https://cloud.umami.is/signup" target="_blank" rel="noopener">umami.is</a> یک حساب رایگان بسازید.</li>
            <li>«Add website» را بزنید؛ نام: هوشیوا، دامنه: <b>houshiva.ir</b>.</li>
            <li>
              «Website ID» را کپی کنید و در ویرایشگر، بخش «تنظیمات سایت ← اطلاعات تماس، شبکه‌های اجتماعی و آمار»، در فیلد
              «شناسه‌ی سایت در Umami» بگذارید و ذخیره کنید. {hasUmami && <b>(این مرحله انجام شده ✓)</b>}
            </li>
            <li>در تنظیمات همان سایت در Umami، «Share URL» را روشن کنید و لینکش را این‌جا بگذارید تا آمار داخل همین پنل نمایش داده شود:</li>
          </ol>
          <form class="admin__form js-embed-form">
            <input type="url" placeholder="https://cloud.umami.is/share/..." dir="ltr" required />
            <button type="submit" class="admin__btn">نمایش آمار</button>
          </form>
          <p class="admin__muted">این لینک فقط در همین مرورگر ذخیره می‌شود و در سایت منتشر نمی‌شود.</p>
        </div>
      </section>

      <section class="admin__links">
        {
          links.map((l) => (
            <a class="admin__quick" href={l.href} target="_blank" rel="noopener">
              <span class="admin__card-icon"><Icon name={l.icon} size={20} /></span>
              <span>
                <b>{l.label}</b>
                <small>{l.description}</small>
              </span>
            </a>
          ))
        }
      </section>
    </div>
    <i hidden data-admin-end></i>

    <script>
      import { unlockAdmin, lockAdmin } from '../../lib/adminLock';

      const fa = (d: Date) =>
        d.toLocaleString('fa-IR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });

      function initPanel() {
        document.getElementById('admin-logout')!.addEventListener('click', lockAdmin);

        document.querySelectorAll<HTMLElement>('[data-date]').forEach((el) => {
          el.textContent = fa(new Date(el.dataset.date!));
        });

        // ---- deploy runs (public GitHub API, no token needed) ----
        const runsEl = document.getElementById('runs')!;
        const ago = (d: Date) => {
          const m = Math.round((Date.now() - d.getTime()) / 60000);
          if (m < 1) return 'همین الان';
          if (m < 60) return `${m.toLocaleString('fa-IR')} دقیقه پیش`;
          const h = Math.round(m / 60);
          if (h < 24) return `${h.toLocaleString('fa-IR')} ساعت پیش`;
          return `${Math.round(h / 24).toLocaleString('fa-IR')} روز پیش`;
        };
        const label = (r: { status: string; conclusion: string | null }) =>
          r.status !== 'completed'
            ? ['در حال انتشار…', 'running']
            : r.conclusion === 'success'
              ? ['منتشر شد', 'ok']
              : ['ناموفق', 'fail'];
        const why = (r: { event: string; display_title: string }) =>
          r.event === 'schedule' ? 'به‌روزرسانی خودکار قیمت‌ها' : r.event === 'workflow_dispatch' ? 'انتشار دستی' : r.display_title;

        async function loadRuns() {
          try {
            const res = await fetch(`https://api.github.com/repos/${runsEl.dataset.repo}/actions/runs?per_page=6`);
            if (!res.ok) throw new Error(String(res.status));
            const { workflow_runs: runs } = await res.json();
            runsEl.replaceChildren(
              ...runs.map((r: any) => {
                const [text, cls] = label(r);
                const li = document.createElement('li');
                li.innerHTML = `<span class="admin__dot admin__dot--${cls}"></span><span class="admin__run-title" dir="auto"></span><span class="admin__run-meta">${text} · ${ago(new Date(r.created_at))}</span>`;
                li.querySelector('.admin__run-title')!.textContent = why(r);
                return li;
              }),
            );
            if (runs.some((r: any) => r.status !== 'completed')) setTimeout(loadRuns, 15000);
          } catch {
            runsEl.innerHTML = '<li class="admin__muted">دریافت وضعیت ممکن نشد؛ لینک پایین را باز کنید.</li>';
          }
        }
        loadRuns();

        // ---- embedded reports (Search Console via Looker Studio, Umami); links remembered only in this browser ----
        document.querySelectorAll<HTMLElement>('[data-embed]').forEach((card) => {
          const key = card.dataset.embed!;
          const view = card.querySelector<HTMLElement>('.js-embed-view')!;
          const setup = card.querySelector<HTMLElement>('.js-embed-setup')!;
          const frame = card.querySelector<HTMLIFrameElement>('.js-embed-frame')!;
          const open = card.querySelector<HTMLAnchorElement>('.js-embed-open')!;
          const reset = card.querySelector<HTMLElement>('.js-embed-reset')!;
          const form = card.querySelector<HTMLFormElement>('.js-embed-form')!;

          const show = (url: string | null) => {
            view.hidden = !url;
            reset.hidden = !url;
            setup.hidden = Boolean(url);
            if (url) {
              frame.src = url;
              open.href = url;
            }
          };
          const store = (url: string | null) => {
            try {
              if (url) localStorage.setItem(key, url);
              else localStorage.removeItem(key);
            } catch {}
            show(url);
          };

          form.addEventListener('submit', (e) => {
            e.preventDefault();
            store(form.querySelector('input')!.value.trim());
          });
          reset.addEventListener('click', () => store(null));

          let saved: string | null = null;
          try {
            saved = localStorage.getItem(key);
          } catch {}
          show(saved);
        });
      }

      unlockAdmin(initPanel);
    </script>

    <style is:global>
      /* Global: the deploy rows are created by the script below, which scoped styles would miss. */
      body {
        background: var(--color-background);
      }

      .admin [hidden],
      .admin-login [hidden] {
        display: none !important;
      }

      .admin-login {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: var(--space-4);
      }

      .admin-login:empty,
      .admin-login.is-done {
        display: none;
      }

      .admin-login__card {
        width: min(400px, 100%);
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-8);
        background:
          linear-gradient(150deg, var(--color-primary-soft), transparent 60%),
          var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        color: var(--color-text-muted);
        line-height: var(--line-height-normal);
      }

      .admin-login__card img {
        border-radius: var(--radius-md);
      }

      .admin-login__card h1 {
        font-size: var(--font-size-xl);
        color: var(--color-text);
        margin-bottom: calc(-1 * var(--space-3));
      }

      .admin-login__card label {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        color: var(--color-text);
      }

      .admin-login__card input {
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border-strong);
        background: var(--color-background-alt);
        color: var(--color-text);
        font: inherit;
      }

      .admin-login__card input:focus {
        outline: 2px solid var(--color-primary);
        outline-offset: 1px;
      }

      .admin-login__card .admin__btn {
        width: 100%;
      }

      .admin-login__error {
        font-size: var(--font-size-sm);
        color: var(--color-danger);
      }

      .admin__top-actions {
        display: flex;
        gap: var(--space-3);
      }

      .admin {
        max-width: 1180px;
        margin-inline: auto;
        padding: var(--space-10) var(--space-4) var(--space-16);
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
      }

      .admin__top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: var(--space-4);
        flex-wrap: wrap;
      }

      .admin__eyebrow {
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        color: var(--color-primary-hover);
      }

      .admin__top h1 {
        font-size: var(--font-size-2xl);
        margin-block: var(--space-1);
      }

      .admin__sub,
      .admin__muted {
        font-size: var(--font-size-sm);
        color: var(--color-text-subtle);
      }

      .admin__stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: var(--space-4);
      }

      .admin__stat {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-5);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        color: var(--color-text-muted);
        transition: border-color var(--transition-base);
      }

      .admin__stat:hover {
        border-color: var(--color-primary);
      }

      .admin__stat b {
        font-size: var(--font-size-2xl);
        color: var(--color-text);
      }

      .admin__stat-icon,
      .admin__card-icon {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border-radius: var(--radius-md);
        background: var(--color-primary-soft);
        color: var(--color-primary-hover);
      }

      .admin__grid {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        gap: var(--space-6);
      }

      .admin__card {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        padding: var(--space-6);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
      }

      .admin__card--edit {
        background:
          linear-gradient(150deg, var(--color-primary-soft), transparent 60%),
          var(--color-surface);
        border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
      }

      .admin__card-head {
        display: flex;
        align-items: flex-start;
        gap: var(--space-3);
      }

      .admin__card-head > div {
        flex: 1;
      }

      .admin__card h2 {
        font-size: var(--font-size-lg);
      }

      .admin__card-head p,
      .admin__note {
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
        margin-top: var(--space-1);
      }

      .admin__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-2);
        width: fit-content;
        padding: var(--space-3) var(--space-6);
        border-radius: var(--radius-full);
        border: 1px solid transparent;
        background: var(--color-primary);
        color: var(--color-text-on-primary);
        font: inherit;
        font-weight: var(--font-weight-semibold);
        cursor: pointer;
        transition: background-color var(--transition-base);
      }

      .admin__btn:hover {
        background: var(--color-primary-hover);
      }

      .admin__btn--ghost {
        background: transparent;
        border-color: var(--color-border-strong);
        color: var(--color-text);
      }

      .admin__btn--ghost:hover {
        background: var(--color-surface-hover);
      }

      .admin__btn--small {
        padding: var(--space-2) var(--space-4);
        font-size: var(--font-size-sm);
      }

      .admin__setup ol {
        list-style: decimal;
        padding-inline-start: var(--space-6);
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        margin-block: var(--space-3);
        font-size: var(--font-size-sm);
        color: var(--color-text-muted);
      }

      .admin a:not(.admin__btn):not(.admin__stat):not(.admin__quick) {
        color: var(--color-primary-hover);
      }

      .admin__runs {
        display: flex;
        flex-direction: column;
      }

      .admin__runs li {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: var(--space-3);
        padding-block: var(--space-3);
        border-bottom: 1px solid var(--color-border);
        font-size: var(--font-size-sm);
      }

      .admin__run-title {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .admin__run-meta {
        color: var(--color-text-subtle);
        font-size: var(--font-size-xs);
        white-space: nowrap;
      }

      .admin__dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
      }

      .admin__dot--ok {
        background: var(--color-success);
      }

      .admin__dot--fail {
        background: var(--color-danger);
      }

      .admin__dot--running {
        background: var(--color-accent-gold);
        animation: admin-pulse 1.2s ease-in-out infinite;
      }

      @keyframes admin-pulse {
        50% {
          opacity: 0.3;
        }
      }

      .admin__link {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
      }

      .admin__embed {
        width: 100%;
        height: 720px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: #fff;
        margin-bottom: var(--space-3);
      }

      .admin__warn {
        font-size: var(--font-size-sm);
        color: var(--color-accent-gold);
      }

      .admin__form {
        display: flex;
        gap: var(--space-3);
        flex-wrap: wrap;
      }

      .admin__form input {
        flex: 1;
        min-width: 240px;
        padding: var(--space-3) var(--space-4);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border-strong);
        background: var(--color-background-alt);
        color: var(--color-text);
        font: inherit;
      }

      .admin__links {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-4);
      }

      .admin__quick {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4) var(--space-5);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        color: var(--color-text);
        transition: border-color var(--transition-base), transform var(--transition-base);
      }

      .admin__quick:hover {
        border-color: var(--color-primary);
        transform: translateY(-2px);
      }

      .admin__quick small {
        display: block;
        font-size: var(--font-size-xs);
        color: var(--color-text-subtle);
      }

      @media (max-width: 900px) {
        .admin__grid,
        .admin__links {
          grid-template-columns: 1fr;
        }

        .admin__stats {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
    </style>
  </body>
</html>
