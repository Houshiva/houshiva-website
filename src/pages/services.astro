---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import ServiceDetail from '../components/services/ServiceDetail.astro';
import CtaSection from '../components/common/CtaSection.astro';
import GradientMesh from '../components/common/GradientMesh.astro';
import { toneForIndex } from '../lib/tones';
import { services } from '../data/services';
import { site } from '../data/site';

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.title,
        description: service.shortDescription,
        url: new URL(`/services#${service.slug}`, site.url).toString(),
        provider: { '@type': 'Organization', name: site.name, url: site.url },
      },
    })),
  },
];
---

<MainLayout
  title="خدمات هوشیوا"
  description="طراحی سایت، فروشگاه اینترنتی، نرم‌افزار اختصاصی، حسابداری، صندوق فروش، CRM، مدیریت انبار، اتوماسیون، داشبورد مدیریتی و اتصال سامانه‌ها — خدمات کامل هوشیوا برای کسب‌وکار شما."
  path="/services"
  structuredData={structuredData}
>
  <section class="section services-hero">
    <GradientMesh variant="hero" />
    <div class="container">
      <SectionTitle
        as="h1"
        eyebrow="خدمات"
        title="هر راهکار، طراحی‌شده برای همان مسئله‌ای که دارید"
        description="از یک وب‌سایت معرفی خدمات تا سامانه‌های مدیریتی چندبخشی؛ در ادامه می‌توانید جزئیات هر خدمت، مزایا و مناسب بودن آن برای کسب‌وکارتان را ببینید."
        align="center"
      />
    </div>
  </section>

  <section class="services-list">
    <div class="container">
      {
        services.map((service, index) => (
          <ServiceDetail service={service} reversed={index % 2 === 1} tone={toneForIndex(index)} />
        ))
      }
    </div>
  </section>

  <CtaSection
    title="نمی‌دانید کدام راهکار مناسب شماست؟"
    description="کافی است نیاز خود را برایمان توضیح دهید؛ در جلسه مشاوره رایگان، مناسب‌ترین راهکار را با هم مشخص می‌کنیم."
  />
</MainLayout>

<style>
  .services-hero {
    position: relative;
    z-index: 0;
    padding-bottom: 0;
  }

  .services-list {
    padding-bottom: var(--space-16);
  }
</style>
