---
import MainLayout from '../layouts/MainLayout.astro';
import SectionTitle from '../components/common/SectionTitle.astro';
import ServiceDetail from '../components/services/ServiceDetail.astro';
import CtaSection from '../components/common/CtaSection.astro';
import GradientMesh from '../components/common/GradientMesh.astro';
import { toneForIndex } from '../lib/tones';
import Icon from '../components/common/Icon.astro';
import { services, serviceGroups, type ServiceGroup } from '../data/services';
import { site } from '../data/site';

const groups = Object.entries(serviceGroups) as [ServiceGroup, (typeof serviceGroups)[ServiceGroup]][];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: services.map((service, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Service',
        name: service.title,
        description: service.shortDescription,
        url: new URL(`/services#${service.slug}`, site.url).toString(),
        provider: { '@type': 'Organization', name: site.name, url: site.url },
      },
    })),
  },
];
---

<MainLayout
  title="خدمات هوشیوا"
  description="چت‌بات و دستیار هوش مصنوعی، ایجنت‌های هوشمند، پردازش تصویر و اسناد، طراحی سایت، اپلیکیشن موبایل، پلتفرم SaaS، نرم‌افزار اختصاصی، حسابداری، CRM، انبار، داشبورد و زیرساخت ابری — خدمات کامل هوشیوا برای کسب‌وکار شما."
  path="/services"
  structuredData={structuredData}
>
  <section class="section services-hero">
    <GradientMesh variant="hero" />
    <div class="container">
      <SectionTitle
        as="h1"
        eyebrow="خدمات"
        title="هر راهکار، طراحی‌شده برای همان مسئله‌ای که دارید"
        description="از دستیارهای هوش مصنوعی و ایجنت‌های هوشمند تا وب‌سایت، اپلیکیشن و سامانه‌های مدیریتی چندبخشی؛ در ادامه جزئیات هر خدمت، مزایا و مناسب بودن آن برای کسب‌وکارتان را ببینید."
        align="center"
      />

      <nav class="services-nav" aria-label="دسته‌بندی خدمات">
        {
          groups.map(([key, group]) => (
            <a href={`#group-${key}`} class:list={['services-nav__item', { 'services-nav__item--ai': key === 'ai' }]}>
              {key === 'ai' && <Icon name="spark" size={16} />}
              {group.label}
              <span>{services.filter((s) => s.group === key).length}</span>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="services-list">
    <div class="container">
      {
        groups.map(([key, group]) => (
          <section id={`group-${key}`} class="services-group">
            <header class="services-group__header" data-reveal>
              <span class="services-group__eyebrow">{key === 'ai' && <Icon name="spark" size={14} />}{group.label}</span>
              <p>{group.description}</p>
            </header>
            {services
              .filter((s) => s.group === key)
              .map((service, index) => (
                <ServiceDetail service={service} reversed={index % 2 === 1} tone={toneForIndex(index)} />
              ))}
          </section>
        ))
      }
    </div>
  </section>

  <CtaSection
    title="نمی‌دانید کدام راهکار مناسب شماست؟"
    description="کافی است نیاز خود را برایمان توضیح دهید؛ در جلسه مشاوره رایگان، مناسب‌ترین راهکار را با هم مشخص می‌کنیم."
  />
</MainLayout>

<style>
  .services-hero {
    position: relative;
    z-index: 0;
    padding-bottom: 0;
  }

  .services-list {
    padding-bottom: var(--space-16);
  }

  .services-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .services-nav__item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-strong);
    background: var(--color-surface);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    transition:
      border-color var(--transition-base),
      transform var(--transition-base);
  }

  .services-nav__item:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }

  .services-nav__item span {
    font-size: var(--font-size-xs);
    min-width: 22px;
    padding: 0 6px;
    text-align: center;
    border-radius: var(--radius-full);
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .services-nav__item--ai {
    border-color: transparent;
    background:
      linear-gradient(var(--color-surface), var(--color-surface)) padding-box,
      linear-gradient(120deg, var(--color-primary), var(--color-accent-secondary), var(--color-accent-gold), var(--color-primary)) border-box;
    background-size: 100% 100%, 300% 100%;
    animation: services-ai-border 6s linear infinite;
  }

  @keyframes services-ai-border {
    to {
      background-position: 0 0, 300% 0;
    }
  }

  .services-group {
    scroll-margin-top: 90px;
    padding-top: var(--space-12);
  }

  .services-group__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .services-group__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-2xl, 1.6rem);
    font-weight: var(--font-weight-bold, 800);
    color: var(--color-text);
  }

  .services-group__header p {
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .services-nav__item--ai {
      animation: none;
    }
  }
</style>
