---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/common/Icon.astro';
import CtaSection from '../../components/common/CtaSection.astro';
import { toolSchema } from '../../lib/seo';

const title = 'کارت دعوت جشن و عروسی';
const description = 'ساخت رایگان کارت دعوت زیبا برای عروسی، تولد و مراسم؛ چند قالب رنگی، پیش‌نمایش زنده و آماده دانلود یا چاپ.';
---

<MainLayout
  title={title}
  description={description}
  path="/tools/event-card"
  breadcrumbs={[{ label: 'ابزارها', path: '/tools' }, { label: 'کارت دعوت', path: '/tools/event-card' }]}
  structuredData={[toolSchema(title, description, '/tools/event-card')]}
>
  <article class="section tool-page">
    <div class="container">
      <a href="/tools" class="tool-page__back">
        <Icon name="chevron-start" size={16} />
        بازگشت به ابزارها
      </a>

      <h1 class="text-balance">کارت دعوت جشن و عروسی</h1>
      <p class="tool-page__lead">
        برای عروسی، تولد یا هر مراسم دیگری، کارت دعوت را در فرم زیر بسازید؛ پیش‌نمایش زنده در سمت راست، همزمان
        با تایپ به‌روز می‌شود.
      </p>

      <div class="event-tool" data-event-tool>
        <div class="event-tool__form">
          <section class="event-tool__section">
            <h2>اطلاعات مراسم</h2>
            <label class="event-tool__full">
              <span>نوع مراسم</span>
              <input type="text" data-field="occasion" placeholder="مثلاً جشن عروسی" />
            </label>
            <label class="event-tool__full">
              <span>نام میزبان‌ها</span>
              <input type="text" data-field="names" placeholder="مثلاً سارا و علی" />
            </label>
            <div class="event-tool__grid">
              <label>
                <span>تاریخ</span>
                <input type="text" data-field="date" placeholder="مثلاً جمعه، ۱۴ شهریور ۱۴۰۴" />
              </label>
              <label>
                <span>ساعت</span>
                <input type="text" data-field="time" placeholder="مثلاً ۱۸:۰۰" />
              </label>
            </div>
            <label class="event-tool__full">
              <span>مکان</span>
              <input type="text" data-field="location" placeholder="مثلاً تالار نمونه، تهران" />
            </label>
            <label class="event-tool__full">
              <span>متن دعوت</span>
              <textarea data-field="message" rows="3" placeholder="با آرزوی خوشبختی، حضور گرم شما را در این مراسم خواهانیم."></textarea>
            </label>
          </section>

          <section class="event-tool__section">
            <h2>عکس (اختیاری)</h2>
            <div class="event-tool__photo">
              <div class="event-tool__photo-preview" data-photo-preview>
                <Icon name="spark" size={22} />
              </div>
              <div class="event-tool__photo-actions">
                <label class="event-tool__photo-upload">
                  آپلود عکس
                  <input type="file" accept="image/*" data-photo-input hidden />
                </label>
                <button type="button" class="event-tool__photo-remove" data-remove-photo hidden>حذف عکس</button>
              </div>
            </div>
          </section>

          <section class="event-tool__section">
            <h2>قالب رنگی</h2>
            <div class="event-tool__themes" data-theme-swatches>
              <button type="button" class="is-active" data-theme="gold" aria-label="کلاسیک طلایی">
                <span style="background: linear-gradient(160deg, #2b2418, #1a1610)"></span>
              </button>
              <button type="button" data-theme="rose" aria-label="رمانتیک">
                <span style="background: linear-gradient(160deg, #fbe9ec, #f6d3da)"></span>
              </button>
              <button type="button" data-theme="mono" aria-label="مینیمال مشکی">
                <span style="background: linear-gradient(160deg, #101012, #0a0a0c)"></span>
              </button>
              <button type="button" data-theme="sage" aria-label="سبز و کرم">
                <span style="background: linear-gradient(160deg, #f3f1e6, #e8e3d0)"></span>
              </button>
            </div>
          </section>
        </div>

        <div class="event-tool__preview-col">
          <div class="event-tool__actions">
            <button type="button" class="event-tool__print" data-print-event>
              <Icon name="copy" size={16} />
              چاپ
            </button>
            <button type="button" class="event-tool__download" data-download-event>
              <Icon name="arrow-start" size={16} class="event-tool__download-icon" />
              دانلود PDF
            </button>
          </div>

          <div class="event-tool__stage">
            <div class="event-tool__card" data-event-card data-theme="gold">
              <div class="event-tool__card-content" data-card-content></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <CtaSection
    title="برای رویدادتان یک صفحه یا سایت اختصاصی هم می‌خواهید؟"
    description="اگر برای مراسم یا رویداد خود به یک صفحه وب برای اطلاع‌رسانی و ثبت حضور نیاز دارید، برایتان طراحی می‌کنیم."
  />
</MainLayout>

<style>
  .tool-page {
    padding-bottom: var(--space-16);
  }

  .tool-page__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .tool-page__back:hover {
    color: var(--tone-accent-hover);
  }

  .tool-page__back :global(svg) {
    transform: scaleX(-1);
  }

  .tool-page h1 {
    margin-bottom: var(--space-4);
  }

  .tool-page__lead {
    font-size: var(--font-size-lg);
    max-width: 70ch;
    margin-bottom: var(--space-10);
  }

  .event-tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .event-tool__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .event-tool__section {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .event-tool__section h2 {
    font-size: var(--font-size-base);
    margin-bottom: var(--space-4);
  }

  .event-tool__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .event-tool__form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
  }

  .event-tool__full {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }

  .event-tool__full:last-child {
    margin-bottom: 0;
  }

  .event-tool__form input,
  .event-tool__form textarea {
    background: var(--color-background-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    font-size: var(--font-size-sm);
    font-family: inherit;
    color: var(--color-text);
    width: 100%;
  }

  .event-tool__form input:focus,
  .event-tool__form textarea:focus {
    outline: none;
    border-color: var(--tone-accent);
  }

  .event-tool__form textarea {
    resize: vertical;
  }

  /* ---- Photo upload ---- */

  .event-tool__photo {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .event-tool__photo-preview {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--tone-accent-soft);
    color: var(--tone-accent-hover);
    border: 1px solid var(--color-border);
  }

  .event-tool__photo-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-tool__photo-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .event-tool__photo-upload {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--tone-accent-hover);
    background: var(--tone-accent-soft);
    border-radius: var(--radius-full);
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .event-tool__photo-upload:hover {
    background: color-mix(in srgb, var(--tone-accent-soft) 55%, var(--tone-accent) 45%);
  }

  .event-tool__photo-remove {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }

  .event-tool__photo-remove:hover {
    color: var(--color-danger, #e5484d);
  }

  /* ---- Theme swatches ---- */

  .event-tool__themes {
    display: flex;
    gap: var(--space-3);
  }

  .event-tool__themes button {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    padding: 0;
    border: 2px solid transparent;
    cursor: pointer;
    overflow: hidden;
    transition: transform var(--transition-fast);
  }

  .event-tool__themes button span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
  }

  .event-tool__themes button:hover {
    transform: scale(1.08);
  }

  .event-tool__themes button.is-active {
    border-color: var(--tone-accent);
  }

  /* ---- Preview column ---- */

  .event-tool__preview-col {
    position: sticky;
    top: calc(var(--space-8) + 64px);
  }

  .event-tool__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .event-tool__print,
  .event-tool__download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: none;
    border-radius: var(--radius-full);
    padding: var(--space-3) var(--space-5);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast),
      background-color var(--transition-fast);
  }

  .event-tool__print {
    background: var(--tone-accent-soft);
    color: var(--tone-accent-hover);
  }

  .event-tool__print:hover {
    background: color-mix(in srgb, var(--tone-accent-soft) 55%, var(--tone-accent) 45%);
  }

  .event-tool__download {
    background: var(--tone-accent);
    color: var(--color-on-accent, white);
  }

  .event-tool__download:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .event-tool__download-icon {
    transform: rotate(-90deg);
  }

  .event-tool__stage {
    display: flex;
    justify-content: center;
    padding: var(--space-10);
    background: var(--color-background-alt);
    border-radius: var(--radius-lg);
  }

  .event-tool__card {
    width: 320px;
    aspect-ratio: 0.68 / 1;
    border-radius: 6px;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  @media (max-width: 960px) {
    .event-tool {
      grid-template-columns: 1fr;
    }

    .event-tool__preview-col {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .event-tool__grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    :global(header),
    :global(footer),
    :global(.whatsapp-fab),
    :global(.skip-link),
    .tool-page__back,
    .tool-page__lead,
    .event-tool__form,
    .event-tool__actions,
    :global(.cta) {
      display: none !important;
    }

    :global(h1) {
      display: none;
    }

    .event-tool {
      display: block;
    }

    .event-tool__preview-col {
      position: static;
    }

    .event-tool__stage {
      background: none;
      padding: 0;
    }

    .event-tool__card {
      box-shadow: none;
      width: 100%;
      max-width: 400px;
      margin-inline: auto;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
  }
</style>

<style is:global>
  .event-preview {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    padding: 32px 22px;
    background: var(--event-bg, #1a1610);
    color: var(--event-ink, #f3e6c8);
    font-family: inherit;
  }

  .event-preview::before {
    content: '';
    position: absolute;
    inset: 14px;
    border: 1px solid var(--event-accent, #d9b46a);
    opacity: 0.7;
    pointer-events: none;
  }

  .event-preview__photo {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--event-accent, #d9b46a);
    margin-bottom: 4px;
  }

  .event-preview__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .event-preview__occasion {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--event-accent, #d9b46a);
    font-weight: 600;
  }

  .event-preview__names {
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .event-preview__divider {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 70%;
    color: var(--event-accent, #d9b46a);
    font-size: 0.8rem;
    margin-block: 2px;
  }

  .event-preview__divider::before,
  .event-preview__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  .event-preview__message {
    font-size: 0.75rem;
    line-height: 1.8;
    max-width: 90%;
    opacity: 0.95;
  }

  .event-preview__meta {
    font-size: 0.78rem;
    line-height: 2;
  }

  .event-preview__empty {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    font-size: 0.8rem;
    opacity: 0.85;
    background: var(--event-bg, #1a1610);
    color: var(--event-ink, #f3e6c8);
  }
</style>

<script>
  interface EventTheme {
    bg: string;
    ink: string;
    accent: string;
  }

  const THEMES: Record<string, EventTheme> = {
    gold: { bg: 'linear-gradient(160deg, #2b2418, #1a1610)', ink: '#f3e6c8', accent: '#d9b46a' },
    rose: { bg: 'linear-gradient(160deg, #fbe9ec, #f6d3da)', ink: '#6b2b3a', accent: '#c96b83' },
    mono: { bg: 'linear-gradient(160deg, #101012, #0a0a0c)', ink: '#f5f5f5', accent: '#ffffff' },
    sage: { bg: 'linear-gradient(160deg, #f3f1e6, #e8e3d0)', ink: '#3c4a34', accent: '#7c8f5e' },
  };

  function escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function field(root: ParentNode, name: string): HTMLInputElement | HTMLTextAreaElement | null {
    return root.querySelector(`[data-field="${name}"]`);
  }

  function applyTheme(cardEl: HTMLElement, key: string) {
    const theme = THEMES[key] ?? THEMES.gold;
    cardEl.style.setProperty('--event-bg', theme.bg);
    cardEl.style.setProperty('--event-ink', theme.ink);
    cardEl.style.setProperty('--event-accent', theme.accent);
  }

  function initEventCard() {
    const root = document.querySelector<HTMLElement>('[data-event-tool]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const cardEl = root.querySelector<HTMLElement>('[data-event-card]');
    const cardContent = root.querySelector<HTMLElement>('[data-card-content]');
    const photoInput = root.querySelector<HTMLInputElement>('[data-photo-input]');
    const photoPreview = root.querySelector<HTMLElement>('[data-photo-preview]');
    const photoRemoveBtn = root.querySelector<HTMLButtonElement>('[data-remove-photo]');
    const themeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-theme-swatches] button'));
    const printBtn = root.querySelector<HTMLButtonElement>('[data-print-event]');
    const downloadBtn = root.querySelector<HTMLButtonElement>('[data-download-event]');

    if (!cardEl || !cardContent) return;

    let photoDataUrl: string | null = null;
    const defaultPhotoPreviewHtml = photoPreview?.innerHTML ?? '';

    applyTheme(cardEl, 'gold');

    function render() {
      const occasion = field(root!, 'occasion')?.value.trim() ?? '';
      const names = field(root!, 'names')?.value.trim() ?? '';
      const date = field(root!, 'date')?.value.trim() ?? '';
      const time = field(root!, 'time')?.value.trim() ?? '';
      const location = field(root!, 'location')?.value.trim() ?? '';
      const message = field(root!, 'message')?.value.trim() ?? '';

      const hasAnyContent = occasion || names || date || time || location || message || photoDataUrl;

      if (!hasAnyContent) {
        cardContent!.innerHTML = '<div class="event-preview__empty">با پر کردن فرم، کارت دعوت شما همین‌جا ساخته می‌شود.</div>';
        return;
      }

      const photoHtml = photoDataUrl
        ? `<div class="event-preview__photo"><img src="${photoDataUrl}" alt="" /></div>`
        : '';

      const meta = [date, time, location].filter(Boolean).map(escapeHtml).join('<br />');

      cardContent!.innerHTML = `
        <div class="event-preview">
          ${photoHtml}
          ${occasion ? `<div class="event-preview__occasion">${escapeHtml(occasion)}</div>` : ''}
          <div class="event-preview__names">${escapeHtml(names || 'نام میزبان‌ها')}</div>
          <div class="event-preview__divider">✦</div>
          ${message ? `<p class="event-preview__message">${escapeHtml(message)}</p>` : ''}
          ${meta ? `<div class="event-preview__meta">${meta}</div>` : ''}
        </div>
      `;
    }

    photoInput?.addEventListener('change', () => {
      const file = photoInput.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = () => {
        photoDataUrl = reader.result as string;
        if (photoPreview) photoPreview.innerHTML = `<img src="${photoDataUrl}" alt="" />`;
        photoRemoveBtn?.removeAttribute('hidden');
        render();
      };
      reader.readAsDataURL(file);
    });

    photoRemoveBtn?.addEventListener('click', () => {
      photoDataUrl = null;
      if (photoInput) photoInput.value = '';
      if (photoPreview) photoPreview.innerHTML = defaultPhotoPreviewHtml;
      photoRemoveBtn.setAttribute('hidden', '');
      render();
    });

    themeButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.theme ?? 'gold';
        applyTheme(cardEl!, key);
        cardEl!.dataset.theme = key;
        themeButtons.forEach((b) => b.classList.toggle('is-active', b === btn));
      });
    });

    root.addEventListener('input', (event) => {
      if ((event.target as HTMLElement).closest('[data-field]')) render();
    });

    printBtn?.addEventListener('click', () => window.print());

    downloadBtn?.addEventListener('click', async () => {
      if (downloadBtn.disabled) return;

      const html2pdf = (await import('html2pdf.js')).default;
      const originalLabel = downloadBtn.innerHTML;
      downloadBtn.disabled = true;
      downloadBtn.textContent = 'در حال آماده‌سازی...';

      const names = field(root!, 'names')?.value.trim();
      const filenameBase = (names || 'event-card').replace(/\s+/g, '-');

      try {
        await html2pdf()
          .set({
            margin: 0,
            filename: `${filenameBase}.pdf`,
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 3, useCORS: true },
            jsPDF: { unit: 'mm', format: 'a5', orientation: 'portrait' },
          })
          .from(cardEl)
          .save();
      } finally {
        downloadBtn.disabled = false;
        downloadBtn.innerHTML = originalLabel;
      }
    });

    render();
  }

  document.addEventListener('astro:page-load', initEventCard);
</script>
