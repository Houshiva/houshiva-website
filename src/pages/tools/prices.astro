---
import MainLayout from '../../layouts/MainLayout.astro';
import Icon from '../../components/common/Icon.astro';
import CtaSection from '../../components/common/CtaSection.astro';
import RelatedTools from '../../components/tools/RelatedTools.astro';
import { priceCategories } from '../../data/priceItems';

interface BrsApiEntry {
  symbol: string;
  price: number;
  date: string;
  time: string;
}

interface BrsApiResponse {
  gold?: BrsApiEntry[];
  currency?: BrsApiEntry[];
}

const priceBySymbol = new Map<string, number>();
let lastUpdated: string | null = null;

const brsApiKey = import.meta.env.BRSAPI_KEY;

if (brsApiKey) {
  try {
    const response = await fetch(`https://Api.BrsApi.ir/Market/Gold_Currency.php?key=${brsApiKey}`);
    if (response.ok) {
      const data: BrsApiResponse = await response.json();
      const entries = [...(data.gold ?? []), ...(data.currency ?? [])];
      for (const entry of entries) {
        priceBySymbol.set(entry.symbol, Math.round(entry.price));
      }
      lastUpdated = entries[0] ? `${entries[0].date} - ${entries[0].time}` : null;
    }
  } catch {
    // در دسترس نبودن API در زمان build؛ مقادیر روی «به‌زودی» می‌مانند.
  }
}

function formatPrice(symbol: string): string | null {
  const price = priceBySymbol.get(symbol);
  if (price === undefined) return null;
  return `${price.toLocaleString('fa-IR')} تومان`;
}
---

<MainLayout
  title="قیمت لحظه‌ای طلا و ارز"
  description="قیمت لحظه‌ای طلا، سکه و ارز، به‌صورت دوره‌ای به‌روزرسانی می‌شود."
  path="/tools/prices"
  breadcrumbs={[{ label: 'ابزارها', path: '/tools' }, { label: 'قیمت‌ها', path: '/tools/prices' }]}
>
  <article class="section tool-page">
    <div class="container container--narrow">
      <a href="/tools" class="tool-page__back">
        <Icon name="chevron-start" size={16} />
        بازگشت به ابزارها
      </a>

      <h1 class="text-balance">قیمت طلا و ارز</h1>
      <p class="tool-page__lead">قیمت طلا، سکه و ارز، به‌صورت دوره‌ای به‌روزرسانی می‌شود.</p>
      {lastUpdated && <p class="tool-page__updated">آخرین به‌روزرسانی: {lastUpdated}</p>}

      {
        priceCategories.map((category) => (
          <div class="price-card" data-reveal>
            <h2>{category.label}</h2>
            <ul>
              {category.items.map((item) => {
                const value = formatPrice(item.symbol);
                return (
                  <li>
                    <span>{item.label}</span>
                    <span class:list={['price-card__value', { 'price-card__value--live': value }]}>
                      {value ?? 'به‌زودی'}
                    </span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>
  </article>

  <RelatedTools exclude="prices" />

  <CtaSection
    title="می‌خواهید قیمت‌ها همیشه لحظه‌ای و دقیق باشند؟"
    description="اتصال این صفحه به یک منبع قیمت معتبر و به‌روزرسانی خودکار، دقیقاً از همان جنس کاری است که برای مشتریانمان انجام می‌دهیم."
  />
</MainLayout>

<style>
  .tool-page {
    padding-bottom: var(--space-16);
  }

  .tool-page__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
  }

  .tool-page__back:hover {
    color: var(--tone-accent-hover);
  }

  .tool-page__back :global(svg) {
    transform: scaleX(-1);
  }

  .tool-page h1 {
    margin-bottom: var(--space-4);
  }

  .tool-page__lead {
    font-size: var(--font-size-base);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-4);
  }

  .tool-page__updated {
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-8);
  }

  .price-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    margin-bottom: var(--space-6);
  }

  .price-card h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-4);
  }

  .price-card ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .price-card li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-border-hairline);
    font-size: var(--font-size-sm);
    color: var(--color-text);
  }

  .price-card li:first-child {
    border-top: none;
  }

  .price-card__value {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-subtle);
    background: var(--color-background-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
  }

  .price-card__value--live {
    color: var(--color-success);
    background: color-mix(in srgb, var(--color-success) 12%, transparent);
    border-color: color-mix(in srgb, var(--color-success) 35%, transparent);
  }
</style>
